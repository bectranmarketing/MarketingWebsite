};

// ─── Inline text field ───────────────────────────────────────────────────────
function InlineTextField({
  value,
  onSave,
  placeholder = "—",
  type = "text",
  className = "",
}: {
  value: string;
  onSave: (val: string) => void;
  placeholder?: string;
  type?: string;
  className?: string;
}) {
  const [editing, setEditing] = useState(false);
  const [draft, setDraft] = useState(value);
  const inputRef = useRef<HTMLInputElement>(null);

  useEffect(() => {
    setDraft(value);
  }, [value]);

  const open = (e?: React.MouseEvent) => {
    e?.preventDefault();
    e?.stopPropagation();
    setDraft(value);
    setEditing(true);
    setTimeout(() => inputRef.current?.focus(), 0);
  };
  const save = () => {
    setEditing(false);
    if (draft !== value) onSave(draft);
  };
  const cancel = () => {
    setEditing(false);
    setDraft(value);
  };

  if (editing) {
    return (
      <div className="flex items-center gap-1.5">
        <Input
          ref={inputRef}
          type={type}
          value={draft}
          onChange={(e) => setDraft(e.target.value)}
          onBlur={save}
          onKeyDown={(e) => {
            if (e.key === "Enter") save();
            if (e.key === "Escape") cancel();
          }}
          className={`h-9 sm:h-7 text-sm py-0 px-2 min-w-0 ${className}`}
          onClick={(e) => e.stopPropagation()}
        />
      </div>
    );
  }

  const isEmail = type === "email";

  return (
    <button
      type="button"
      onClick={open}
      title="Click to edit"
      className={`group relative text-left w-full text-sm leading-snug transition-colors rounded px-1.5 py-1 flex gap-1.5 hover:bg-muted/60 cursor-pointer ${
        isEmail ? "items-start" : "items-center min-h-[36px] sm:min-h-[28px]"
      } ${value ? "text-foreground" : "text-muted-foreground/50 italic"} ${className}`}
    >
      <span className={isEmail ? "break-all" : "truncate"}>
        {value || placeholder}
      </span>
      <Pencil className="h-3 w-3 shrink-0 opacity-0 group-hover:opacity-40 transition-opacity" />
    </button>
  );
}

// ─── Inline dropdown field ───────────────────────────────────────────────────
function InlineDropdown({
  value,
  options,
  onSave,
  placeholder = "—",
  isSaving = false,
}: {
  value: string;
  options: string[];
  onSave: (val: string) => void;
  placeholder?: string;
  isSaving?: boolean;
}) {
  const [open, setOpen] = useState(false);
  const [pending, setPending] = useState<string | null>(null);
  const displayed = pending ?? value;
  const ref = useRef<HTMLDivElement>(null);

  useEffect(() => {
    if (pending && pending === value) setPending(null);
  }, [value, pending]);

  useEffect(() => {
    if (!open) return;
    const handler = (e: MouseEvent) => {
      if (ref.current && !ref.current.contains(e.target as Node)) setOpen(false);
    };
    document.addEventListener("mousedown", handler);
    return () => document.removeEventListener("mousedown", handler);
  }, [open]);

  const selectOpt = (opt: string) => {
    setPending(opt);
    onSave(opt);
    // Delay closing to ensure save completes
    setTimeout(() => setOpen(false), 100);
  };

  return (
    <div ref={ref} className="relative">
      <button
        type="button"
        onClick={(e) => {
          e.preventDefault();
          e.stopPropagation();
          setOpen((v) => !v);
        }}
        className="flex items-center gap-1.5 cursor-pointer group min-h-[36px] sm:min-h-0"
        title="Click to change"
      >
        <Badge
          variant="outline"
          className={`text-xs font-medium transition-all ${
            displayed
              ? getStatusColor(displayed)
              : "bg-muted/60 text-muted-foreground border-border/40"
          } hover:ring-1 hover:ring-primary/30`}
        >
          {displayed || placeholder}
        </Badge>

        {isSaving && (
          <span className="inline-block h-3 w-3 rounded-full border-2 border-primary/30 border-t-primary animate-spin" />
        )}

        <ChevronDown
          className={`h-3 w-3 text-muted-foreground/40 group-hover:text-muted-foreground transition-all duration-150 ${
            open ? "rotate-180" : ""
          }`}
        />
      </button>

      {open && (
        <div
          className="absolute z-50 top-full mt-1.5 left-0 min-w-[160px] max-h-[240px] overflow-y-auto rounded-xl border bg-background shadow-xl animate-in fade-in-0 zoom-in-95 duration-100 p-1"
          onMouseDown={(e) => e.stopPropagation()}
          onClick={(e) => e.stopPropagation()}
        >
          {options.map((opt) => (
            <button
              key={opt}
              type="button"
              onClick={(e) => {
                e.preventDefault();
                e.stopPropagation();
                selectOpt(opt);
              }}
              className={`w-full flex items-center justify-between gap-2 px-2.5 py-2 sm:py-1.5 rounded-lg text-sm transition-colors text-left ${
                displayed === opt ? "bg-muted/80" : "hover:bg-muted/50"
              }`}
            >
              <span
                className={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium border ${getStatusColor(
                  opt
                )}`}
              >
                {opt}
              </span>
              {displayed === opt && (
                <Check className="h-3.5 w-3.5 text-primary shrink-0" />
              )}
            </button>
          ))}
        </div>
      )}
    </div>
  );
}

