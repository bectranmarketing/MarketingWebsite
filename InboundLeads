        type="button"
        onClick={() => setCollapsed((v) => !v)}
        className="w-full flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-amber-100/60 dark:hover:bg-amber-900/20 transition-colors text-left"
      >
        <div className="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-amber-500/15">
          <AlertCircle className="h-4 w-4 text-amber-600" />
        </div>
        <div className="flex-1 min-w-0">
          <p className="text-sm font-semibold text-amber-900 dark:text-amber-200">
            Needs AE Assignment
          </p>
          <p className="text-xs text-amber-700/70 dark:text-amber-400/70">
            {items.length} {items.length === 1 ? "lead" : "leads"} waiting to be
            assigned — click any to expand and assign
          </p>
        </div>
        <span className="shrink-0 flex h-5 w-5 items-center justify-center rounded-full bg-amber-500 text-white text-xs font-bold">
          {items.length}
        </span>
        <ChevronDown
          className={`h-4 w-4 shrink-0 text-amber-600/60 transition-transform duration-200 ${
            collapsed ? "-rotate-90" : ""
          }`}
        />
      </button>

      {!collapsed && (
        <div className="border-t border-amber-300/30 px-3 pb-3 pt-2 space-y-2">
          {items.map((item: any) => (
            <LeadCard
              key={item.id}
              item={item}
              onUpdate={onUpdate}
              isSaving={savingId === item.id}
            />
          ))}
        </div>
      )}
    </div>
  );
}

// ─── Sort button ─────────────────────────────────────────────────────────────
function SortButton({
  label,
  field,
  active,
  order,
  onClick,
}: {
  label: string;
  field: string;
  active: boolean;
  order: "asc" | "desc";
  onClick: () => void;
}) {
  return (
    <button
      type="button"
      onClick={onClick}
      className={`flex items-center gap-1 text-xs font-medium transition-colors hover:text-foreground ${
        active ? "text-primary" : "text-muted-foreground"
      }`}
    >
      {label}
      <ArrowUpDown className={`h-3 w-3 ${active ? "text-primary" : "text-muted-foreground/40"}`} />
    </button>
  );
}

// ─── Main export ─────────────────────────────────────────────────────────────
export default function Block() {
  const [searchTerm, setSearchTerm] = useState("");
  const [sortField, setSortField] = useState<string | null>("date");
  const [sortOrder, setSortOrder] = useState<"asc" | "desc">("desc");
  const [filterQuality, setFilterQuality] = useState("");
  const [filterAE, setFilterAE] = useState("");
  const [filtersOpen, setFiltersOpen] = useState(false);
  const [savingId, setSavingId] = useState<string | null>(null);
  const searchRef = useRef<HTMLInputElement>(null);

  const { data, status, refetch } = useRecords({
    select,
    where: searchTerm
      ? q.or(
          q.text("name").contains(searchTerm),
          q.text("company").contains(searchTerm),
          q.text("email").contains(searchTerm)
        )
      : undefined,
    orderBy: sortField
      ? sortOrder === "asc"
        ? q.asc(sortField)
        : q.desc(sortField)
      : undefined,
    count: 100,
  });

  const updateRecord = useRecordUpdate({
    fields: updateFields,
    async onSuccess() {
      await refetch();
      toast.success("Saved");
      setSavingId(null);
    },
    onError(error: any) {
      toast.error(`Failed to save: ${error.message}`);
      setSavingId(null);
    },
  });

  const allItems = data?.pages.flatMap((page: any) => page.items) ?? [];

  const unassignedItems = allItems.filter((item: any) => {
    const ae = labelOf(item.fields.ae);
    return !ae || ae === "None";
  });

  const assignedItems = allItems.filter((item: any) => {
    const ae = labelOf(item.fields.ae);
    return ae && ae !== "None";
  });

  const items = assignedItems.filter((item: any) => {
    const q_ = labelOf(item.fields.quality);
    const ae_ = labelOf(item.fields.ae);
    if (filterQuality && q_ !== filterQuality) return false;
    if (filterAE && ae_ !== filterAE) return false;
    return true;
  });

  const handleSort = (field: string) => {
    if (sortField === field) setSortOrder((o) => (o === "asc" ? "desc" : "asc"));
    else {
      setSortField(field);
      setSortOrder("asc");
    }
  };

  const handleUpdate = (recordId: string, field: string, value: any) => {
    setSavingId(recordId);
    try {
      updateRecord.mutate({ recordId, fields: { [field]: value } });
    } catch (err: any) {
      toast.error(`Save error (${field}): ${err?.message ?? "unknown"}`);
      setSavingId(null);
    }
  };

  const activeFilterCount = [filterQuality, filterAE].filter(Boolean).length;

  if (status === "pending") {
    return (
      <div className="min-h-screen bg-background flex items-center justify-center">
        <div className="flex flex-col items-center gap-3 text-muted-foreground">
          <span className="inline-block h-6 w-6 rounded-full border-2 border-primary/30 border-t-primary animate-spin" />
          <span className="text-sm">Loading leads…</span>
        </div>
      </div>
    );
  }

  if (status === "error") {
    return (
      <div className="min-h-screen bg-background flex items-center justify-center">
        <p className="text-destructive text-sm">Error loading leads.</p>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-background">
      <div className="max-w-5xl mx-auto px-3 sm:px-4 py-6 sm:py-10">
        <div className="mb-8">
          <h1 className="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">
            Inbound Leads
          </h1>
          <p className="mt-1.5 text-muted-foreground text-base">
            Review, qualify, and update every inbound lead — click any row to expand and edit.
          </p>
        </div>

        <div className="flex gap-3 mb-4">
          <div className="relative flex-1">
            <Search className="absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground pointer-events-none" />
            <Input
              ref={searchRef}
              type="text"
              placeholder="Search by name, company, email…"
              value={searchTerm}
              onChange={(e) => setSearchTerm(e.target.value)}
              className="pl-10 h-12 sm:h-11 text-base sm:text-sm bg-background"
            />
            {searchTerm && (
              <button
                type="button"
                className="absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground transition-colors"
                onClick={() => setSearchTerm("")}
                aria-label="Clear search"
              >
                <X className="h-4 w-4" />
              </button>
            )}
          </div>

          <Button
            variant={filtersOpen ? "default" : "outline"}
            onClick={() => setFiltersOpen((v) => !v)}
            className="h-12 sm:h-11 gap-2 shrink-0"
            type="button"
          >
            <SlidersHorizontal className="h-4 w-4" />
            Filters
            {activeFilterCount > 0 && (
              <span className="ml-0.5 flex h-5 w-5 items-center justify-center rounded-full bg-white/20 text-xs font-semibold">
                {activeFilterCount}
              </span>
            )}
          </Button>
        </div>

        {filtersOpen && (
          <div className="mb-4 p-4 rounded-xl border bg-muted/30 animate-in fade-in-0 slide-in-from-top-2 duration-200">
            <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
              <FilterSelect
                label="Quality"
                value={filterQuality}
                options={QUALITY_OPTIONS}
                onChange={setFilterQuality}
              />
              <FilterSelect
                label="Account Exec"
                value={filterAE}
                options={AE_OPTIONS}
                onChange={setFilterAE}
              />
              <FilterSelect
                label="Sort by"
                value={sortField ? `${sortField}|${sortOrder}` : ""}
                options={[
                  { label: "Date (newest)", value: "date|desc" },
                  { label: "Date (oldest)", value: "date|asc" },
                  { label: "Name A→Z", value: "name|asc" },
                  { label: "Name Z→A", value: "name|desc" },
                  { label: "Company A→Z", value: "company|asc" },
                ]}
                onChange={(v) => {
                  const [f, o] = v.split("|");
                  setSortField(f);
                  setSortOrder((o as "asc" | "desc") ?? "asc");
                }}
                isComplex
              />
            </div>
          </div>
        )}

        {activeFilterCount > 0 && (
          <div className="flex flex-wrap items-center gap-2 mb-4">
            {filterQuality && (
              <FilterChip label="Quality" value={filterQuality} onRemove={() => setFilterQuality("")} />
            )}
            {filterAE && (
              <FilterChip label="AE" value={filterAE} onRemove={() => setFilterAE("")} />
            )}
            <button
              type="button"
              onClick={() => { setFilterQuality(""); setFilterAE(""); }}
              className="text-xs text-muted-foreground hover:text-foreground underline-offset-2 hover:underline transition-colors ml-1"
            >
              Clear all
            </button>
          </div>
        )}

        <UnassignedSection items={unassignedItems} onUpdate={handleUpdate} savingId={savingId} />

        <div className="flex items-center justify-between mb-3 px-1">
          <p className="text-xs text-muted-foreground">
            {items.length} {items.length === 1 ? "lead" : "leads"}
          </p>
          <div className="flex items-center gap-4">
            <SortButton label="Name" field="name" active={sortField === "name"} order={sortOrder} onClick={() => handleSort("name")} />
            <SortButton label="Company" field="company" active={sortField === "company"} order={sortOrder} onClick={() => handleSort("company")} />
            <SortButton label="Date" field="date" active={sortField === "date"} order={sortOrder} onClick={() => handleSort("date")} />
          </div>
        </div>

        <div className="space-y-2">
          {items.map((item: any) => (
            <LeadCard
              key={item.id}
              item={item}
              onUpdate={handleUpdate}
              isSaving={savingId === item.id}
            />
          ))}
        </div>

        {items.length === 0 && (
          <div className="mt-4 rounded-2xl border-2 border-dashed border-border/60 bg-muted/20 p-12 text-center">
            <div className="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-primary/10">
              <User className="h-7 w-7 text-primary" />
            </div>
            <h2 className="text-xl font-semibold text-foreground mb-2">No leads found</h2>
            <p className="text-muted-foreground text-sm max-w-sm mx-auto">Try adjusting your search or filters.</p>
            {(searchTerm || activeFilterCount > 0) && (
              <Button
                variant="outline"
                className="mt-6"
                onClick={() => { setSearchTerm(""); setFilterQuality(""); setFilterAE(""); }}
                type="button"
              >
                Clear filters
              </Button>
            )}
          </div>
        )}
      </div>
    </div>
  );
}

// ─── Filter chip ─────────────────────────────────────────────────────────────
function FilterChip({ label, value, onRemove }: { label: string; value: string; onRemove: () => void }) {
  return (
    <span className="inline-flex items-center gap-1.5 pl-3 pr-1.5 py-1 rounded-full bg-primary/10 text-primary text-xs font-medium border border-primary/20">
      <span className="opacity-70">{label}:</span>
      <span>{value}</span>
      <button
        type="button"
        onClick={onRemove}
        className="h-4 w-4 flex items-center justify-center rounded-full hover:bg-primary/20 transition-colors ml-0.5"
        aria-label={`Remove ${label} filter`}
      >
        <X className="h-3 w-3" />
      </button>
    </span>
  );
}

// ─── Filter select ────────────────────────────────────────────────────────────
function FilterSelect({
  label,
  value,
  options,
  onChange,
}: {
  label: string;
  value: string;
  options: string[] | { label: string; value: string }[];
  onChange: (v: string) => void;
}) {
  const normalized = options.map((o) => (typeof o === "string" ? { label: o, value: o } : o));
  return (
    <div className="flex flex-col gap-1.5">
      <label className="text-xs font-medium text-muted-foreground">{label}</label>
      <div className="relative">
        <select
          value={value}
          onChange={(e) => onChange(e.target.value)}
          className="w-full h-9 rounded-md border border-input bg-background px-3 pr-8 text-sm appearance-none cursor-pointer focus:outline-none focus:ring-2 focus:ring-ring"
        >
          <option value="">All</option>
          {normalized.map((o) => (
            <option key={o.value} value={o.value}>
              {o.label}
            </option>
          ))}
        </select>
        <ChevronDown className="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 h-3.5 w-3.5 text-muted-foreground" />
      </div>
    </div>
  );
}
