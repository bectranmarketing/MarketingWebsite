// ─── Asset card ────────────────────────────────────────────────────────────────
function AssetCard({
  item,
  onSelect,
  onShare,
  onDownload,
}: {
  item: any;
  onSelect: () => void;
  onShare: (link: string) => void;
  onDownload: (file: any) => void;
}) {
  const f = item.fields;
  const preview = Array.isArray(f.preview) ? f.preview[0] : f.preview;
  const file = Array.isArray(f.file) ? f.file[0] : f.file;
  const subcategories = Array.isArray(f.subcategories)
    ? f.subcategories
    : [f.subcategories].filter(Boolean);
  const catStyle = getCategoryStyle(f.category?.label);
  const CatIcon = catStyle.icon;

  return (
    <Card
      role="listitem"
      className="group overflow-hidden rounded-xl border bg-card hover:border-primary/40 hover:shadow-lg active:scale-[0.99] transition-all duration-200 outline-none focus-within:ring-2 focus-within:ring-primary focus-within:ring-offset-2 cursor-pointer flex flex-col"
      onClick={onSelect}
    >
      {/* Preview */}
      {preview?.url ? (
        <div className="relative h-40 bg-muted overflow-hidden">
          <img
            src={preview.url}
            alt={preview.filename || f.name}
            className="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500 ease-out"
          />
          <div className="absolute inset-0 bg-gradient-to-t from-black/10 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
          <span className="absolute bottom-2.5 right-2.5 flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-background/90 text-foreground text-xs font-medium opacity-0 group-hover:opacity-100 transition-all duration-200 shadow-sm backdrop-blur-sm translate-y-1 group-hover:translate-y-0">
            <Eye className="h-3 w-3" />
            Preview
          </span>
        </div>
      ) : (
        <div className="h-40 bg-muted/40 flex flex-col items-center justify-center gap-2">
          <div className={`h-10 w-10 rounded-lg ${catStyle.bg} ${catStyle.border} border flex items-center justify-center`}>
            <CatIcon className={`h-5 w-5 ${catStyle.text}`} />
          </div>
          <span className="text-[11px] text-muted-foreground/60 font-medium">
            {f.category?.label || "Asset"}
          </span>
        </div>
      )}

      <CardContent className="p-4 flex flex-col flex-1">
        {/* Category + Subcategories */}
        <div className="flex flex-wrap items-center gap-1.5 mb-2.5">
          {f.category?.label && (
            <Badge
              variant="outline"
              className={`text-[11px] font-medium ${catStyle.bg} ${catStyle.text} ${catStyle.border}`}
            >
              <span className={`inline-block h-1.5 w-1.5 rounded-full ${catStyle.dot} mr-1`} />
              {f.category.label}
            </Badge>
          )}
          {subcategories.slice(0, 1).map((sub: any, idx: number) => (
            <Badge key={idx} variant="outline" className="text-[11px]">
              {sub.label || sub}
            </Badge>
          ))}
          {subcategories.length > 1 && (
            <span className="text-[11px] text-muted-foreground">
              +{subcategories.length - 1}
            </span>
          )}
        </div>

        {/* Title */}
        <h3 className="font-semibold text-foreground text-sm leading-snug line-clamp-2 group-hover:text-primary transition-colors duration-200">
          {f.name || "Untitled"}
        </h3>

        {/* Description */}
        {f.description && (
          <p className="text-xs text-muted-foreground mt-1.5 line-clamp-2 leading-relaxed">
            {f.description}
          </p>
        )}

        {/* Spacer */}
        <div className="flex-1 min-h-[8px]" />

        {/* Actions */}
        <div className="flex gap-2 mt-3 pt-3 border-t border-border/40">
          {f.publicLink && (
            <Button
              variant="default"
              size="sm"
              className="flex-1 gap-1.5 min-h-[36px] text-xs font-medium"
              onClick={(e) => {
                e.stopPropagation();
                onShare(f.publicLink);
              }}
            >
              <ExternalLink className="h-3.5 w-3.5" />
              Open
            </Button>
          )}
          {file?.url && (
            <Button
              variant="outline"
              size="sm"
              className="flex-1 gap-1.5 min-h-[36px] text-xs font-medium"
              onClick={(e) => {
                e.stopPropagation();
                onDownload(file);
              }}
            >
              <Download className="h-3.5 w-3.5" />
              Download
            </Button>
          )}
          {!f.publicLink && !file?.url && (
            <span className="text-xs text-muted-foreground/50 italic py-1.5">
              No file available
            </span>
          )}
        </div>
      </CardContent>
    </Card>
  );
}

// ─── Main Component ────────────────────────────────────────────────────────────
export default function Block() {
  const [searchTerm, setSearchTerm] = useState("");
  const [selectedCategory, setSelectedCategory] = useState("");
  const [selectedAsset, setSelectedAsset] = useState<any>(null);
  const [copiedLink, setCopiedLink] = useState<string | null>(null);
  const searchRef = useRef<HTMLInputElement>(null);

  const { data, status, hasNextPage, fetchNextPage, isFetchingNextPage } =
    useRecords({
      select,
      count: 24,
    });

  const items = useMemo(
    () => data?.pages.flatMap((page: any) => page.items) ?? [],
    [data]
  );

  // Derive live category options
  const categories = useMemo(() => {
    const counts = new Map<string, { label: string; count: number }>();
    items.forEach((item: any) => {
      const label = item.fields.category?.label;
      if (label) {
        const lower = label.toLowerCase();
        const existing = counts.get(lower);
        if (existing) existing.count++;
        else counts.set(lower, { label, count: 1 });
      }
    });
    return Array.from(counts.values()).sort((a, b) =>
      a.label.localeCompare(b.label)
    );
  }, [items]);

  // Filtered items
  const filteredItems = useMemo(() => {
    return items.filter((item: any) => {
      if (
        selectedCategory &&
        item.fields.category?.label !== selectedCategory
      )
        return false;
      if (searchTerm) {
        const s = searchTerm.toLowerCase();
        const nameMatch = item.fields.name?.toLowerCase().includes(s);
        const categoryMatch = item.fields.category?.label
          ?.toLowerCase()
          .includes(s);
        const descMatch = item.fields.description?.toLowerCase().includes(s);
        if (!nameMatch && !categoryMatch && !descMatch) return false;
      }
      return true;
    });
  }, [items, searchTerm, selectedCategory]);

  const clearAllFilters = () => {
    setSearchTerm("");
    setSelectedCategory("");
  };

  const handleShare = (link: string) => {
    if (link) window.open(link, "_blank");
  };

  const handleDownload = (file: any) => {
    if (file?.url) window.open(file.url, "_blank");
  };

  const copyLink = async (link: string) => {
    try {
      await navigator.clipboard.writeText(link);
      setCopiedLink(link);
      toast.success("Link copied!");
      setTimeout(() => setCopiedLink(null), 2000);
    } catch {
      toast.error("Failed to copy link");
    }
  };

  const hasActiveFilters = !!(searchTerm || selectedCategory);

  // ─── Detail View ──────────────────────────────────────────────────────────
  if (selectedAsset) {
    const f = selectedAsset.fields;
    const preview = Array.isArray(f.preview) ? f.preview[0] : f.preview;
    const file = Array.isArray(f.file) ? f.file[0] : f.file;
    const subcategories = Array.isArray(f.subcategories)
      ? f.subcategories
      : [f.subcategories].filter(Boolean);
    const catStyle = getCategoryStyle(f.category?.label);
    const CatIcon = catStyle.icon;
    const isCopied = copiedLink === f.publicLink;

    return (
      <div className="min-h-screen bg-background">
        <div className="max-w-5xl mx-auto px-4 py-10">
          {/* Back nav */}
          <button
            onClick={() => setSelectedAsset(null)}
            className="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground mb-6 py-1.5 transition-colors duration-200 group outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 rounded"
          >
            <ArrowLeft className="h-4 w-4 group-hover:-translate-x-0.5 transition-transform" />
            Back to assets
          </button>

          {/* Asset detail card */}
          <div className="rounded-xl border bg-card overflow-hidden shadow-sm">
            {/* Preview image */}
            {preview?.url ? (
              <div className="relative bg-muted">
                <img
                  src={preview.url}
                  alt={preview.filename || f.name}
                  className="w-full max-h-[480px] object-contain mx-auto"
                />
              </div>
            ) : (
              <div className="h-48 bg-muted/40 flex flex-col items-center justify-center gap-3">
                <div
                  className={`h-16 w-16 rounded-xl ${catStyle.bg} ${catStyle.border} border flex items-center justify-center`}
                >
                  <CatIcon className={`h-8 w-8 ${catStyle.text}`} />
                </div>
                <span className="text-sm text-muted-foreground/60 font-medium">
                  {f.category?.label || "Asset"}
                </span>
              </div>
            )}

            <div className="p-6 sm:p-8">
              {/* Category + Subcategories */}
              <div className="flex flex-wrap items-center gap-2 mb-4">
                {f.category?.label && (
                  <Badge
                    variant="outline"
                    className={`text-xs font-medium ${catStyle.bg} ${catStyle.text} ${catStyle.border}`}
                  >
                    <span
                      className={`inline-block h-1.5 w-1.5 rounded-full ${catStyle.dot} mr-1.5`}
                    />
                    {f.category.label}
                  </Badge>
                )}
                {subcategories.map((sub: any, idx: number) => (
                  <Badge key={idx} variant="outline" className="text-xs">
                    {sub.label || sub}
                  </Badge>
                ))}
              </div>

              {/* Title */}
              <h2 className="text-xl sm:text-2xl font-bold text-foreground mb-3 leading-tight">
                {f.name || "Untitled Asset"}
              </h2>

              {/* Description */}
              {f.description && (
                <p className="text-sm text-muted-foreground leading-relaxed mb-6 max-w-2xl">
                  {f.description}
                </p>
              )}

              {/* Action buttons */}
              <div className="flex flex-wrap gap-3 pt-2">
                {f.publicLink && (
                  <Button
                    onClick={() => handleShare(f.publicLink)}
                    className="gap-2 min-h-[44px]"
                  >
                    <ExternalLink className="h-4 w-4" />
                    Open Link
                  </Button>
                )}
                {file?.url && (
                  <Button
                    variant="outline"
                    onClick={() => handleDownload(file)}
                    className="gap-2 min-h-[44px]"
                  >
                    <Download className="h-4 w-4" />
                    Download File
                  </Button>
                )}
                {f.publicLink && (
                  <Button
                    variant="ghost"
                    onClick={() => copyLink(f.publicLink)}
                    className={`gap-2 min-h-[44px] transition-all duration-200 ${
                      isCopied
                        ? "text-emerald-600 hover:text-emerald-700"
                        : ""
                    }`}
                  >
                    {isCopied ? (
                      <>
                        <Check className="h-4 w-4" /> Copied
                      </>
                    ) : (
                      <>
                        <Copy className="h-4 w-4" /> Copy Link
                      </>
                    )}
                  </Button>
                )}
              </div>
            </div>
          </div>
        </div>
      </div>
    );
  }

  // ─── List View ────────────────────────────────────────────────────────────
  return (
    <div className="min-h-screen bg-background">
      <div className="max-w-5xl mx-auto px-4 py-10">
        {/* ── Page Header ─────────────────────────────────────────────────── */}
        <div className="mb-8">
          <div className="flex items-start justify-between gap-4">
            <div>
              <h1 className="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">
                Asset Library
              </h1>
              <p className="mt-1.5 text-muted-foreground text-sm sm:text-base">
                Browse and download marketing assets, documents, and resources.
              </p>
            </div>
            <a
              href="https://wkf.ms/4mJslYK"
              target="_blank"
              rel="noopener noreferrer"
              className="shrink-0 hidden sm:inline-flex"
            >
              <Button
                variant="outline"
                className="gap-2 border-primary/30 text-primary hover:bg-primary/5 hover:border-primary/60"
              >
                <ExternalLink className="h-4 w-4" />
                Request Asset
              </Button>
            </a>
          </div>
        </div>

        {/* ── Search bar ──────────────────────────────────────────────────── */}
        <div className="flex gap-3 mb-4">
          <div className="relative flex-1">
            <Search className="absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground pointer-events-none" />
            <Input
              ref={searchRef}
              type="text"
              placeholder="Search by name, category, or description..."
              value={searchTerm}
              onChange={(e) => setSearchTerm(e.target.value)}
              className="pl-10 h-11 text-sm bg-background"
            />
            {searchTerm && (
              <button
                className="absolute right-2 top-1/2 -translate-y-1/2 h-7 w-7 flex items-center justify-center rounded text-muted-foreground hover:text-foreground hover:bg-muted active:bg-muted/80 transition-colors duration-200"
                onClick={() => setSearchTerm("")}
                aria-label="Clear search"
              >
                <X className="h-4 w-4" />
              </button>
            )}
          </div>

          {/* Mobile request link */}
          <a
            href="https://wkf.ms/4mJslYK"
            target="_blank"
            rel="noopener noreferrer"
            className="sm:hidden shrink-0"
          >
            <Button
              variant="outline"
              size="icon"
              className="h-11 w-11 border-primary/30 text-primary"
            >
              <ExternalLink className="h-4 w-4" />
            </Button>
          </a>
        </div>

        {/* ── Category chips ──────────────────────────────────────────────── */}
        {categories.length > 0 && (
          <nav aria-label="Asset categories" className="mb-4">
            <div className="flex flex-wrap gap-2">
              <button
                onClick={() => setSelectedCategory("")}
                className={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium border transition-all duration-200 cursor-pointer outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-1 active:scale-[0.97] min-h-[36px]
                  ${
                    !selectedCategory
                      ? "bg-primary text-primary-foreground border-primary shadow-sm"
                      : "bg-background text-muted-foreground border-border hover:border-primary/40 hover:text-foreground"
                  }`}
              >
                <Layers className="h-3 w-3" />
                All
                <span
                  className={`text-[10px] font-bold ${
                    !selectedCategory
                      ? "text-primary-foreground/70"
                      : "text-muted-foreground/60"
                  }`}
                >
                  {items.length}
                </span>
              </button>
              {categories.map(({ label: cat, count }) => {
                const style = getCategoryStyle(cat);
                const isActive = selectedCategory === cat;
                return (
                  <button
                    key={cat}
                    onClick={() =>
                      setSelectedCategory(isActive ? "" : cat)
                    }
                    className={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium border transition-all duration-200 cursor-pointer outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-1 active:scale-[0.97] min-h-[36px]
                      ${
                        isActive
                          ? `${style.bg} ${style.text} ${style.border} shadow-sm`
                          : "bg-background text-muted-foreground border-border hover:border-primary/40 hover:text-foreground"
                      }`}
                  >
                    <span
                      className={`h-2 w-2 rounded-full ${style.dot}`}
                    />
                    {cat}
                    <span
                      className={`text-[10px] font-bold ${
                        isActive
                          ? `${style.text} opacity-60`
                          : "text-muted-foreground/50"
                      }`}
                    >
                      {count}
                    </span>
                  </button>
                );
              })}
            </div>
          </nav>
        )}

        {/* ── Active filter strip ─────────────────────────────────────────── */}
        {selectedCategory && (
          <div className="flex flex-wrap items-center gap-2 mb-4">
            <span className="inline-flex items-center gap-1.5 pl-3 pr-1 py-1 rounded-full bg-primary/10 text-primary text-xs font-medium border border-primary/20">
              <span className="opacity-70">Category:</span>
              <span className="font-semibold">{selectedCategory}</span>
              <button
                onClick={() => setSelectedCategory("")}
                className="h-6 w-6 flex items-center justify-center rounded-full hover:bg-primary/20 active:bg-primary/30 transition-colors"
                aria-label="Remove category filter"
              >
                <X className="h-3 w-3" />
              </button>
            </span>
            <button
              onClick={clearAllFilters}
              className="text-xs text-muted-foreground hover:text-foreground underline-offset-2 hover:underline transition-colors ml-1 py-1.5 px-1"
            >
              Clear all
            </button>
          </div>
        )}

        {/* ── Content Area ────────────────────────────────────────────────── */}

        {/* Loading */}
        {status === "pending" && (
          <div
            className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 min-h-[280px]"
            role="status"
            aria-label="Loading assets"
          >
            {[1, 2, 3, 4, 5, 6].map((i) => (
              <SkeletonCard key={i} />
            ))}
          </div>
        )}

        {/* Error */}
        {status === "error" && (
          <div className="mt-4 rounded-2xl border-2 border-dashed border-destructive/30 bg-destructive/5 p-12 text-center min-h-[280px] flex items-center justify-center">
            <div>
              <div className="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-destructive/10">
                <FileText className="h-7 w-7 text-destructive" />
              </div>
              <h2 className="text-lg font-semibold text-foreground mb-2">
                Error loading assets
              </h2>
              <p className="text-muted-foreground text-sm max-w-sm mx-auto">
                Something went wrong. Please try again later.
              </p>
              <Button
                variant="outline"
                className="mt-6"
                onClick={() => window.location.reload()}
              >
                Reload Page
              </Button>
            </div>
          </div>
        )}

        {/* Success */}
        {status === "success" && (
          <>
            {/* Results header */}
            <div className="flex items-center justify-between mb-4">
              <p className="text-sm text-muted-foreground">
                {filteredItems.length === 0
                  ? "No assets found"
                  : `${filteredItems.length} ${
                      filteredItems.length === 1 ? "asset" : "assets"
                    } available`}
              </p>
              {hasActiveFilters && (
                <Button
                  variant="ghost"
                  size="sm"
                  onClick={clearAllFilters}
                  className="text-muted-foreground gap-1.5"
                >
                  <X className="h-3.5 w-3.5" />
                  Reset
                </Button>
              )}
            </div>

            {/* Empty state */}
            {filteredItems.length === 0 ? (
              <div className="mt-4 rounded-2xl border-2 border-dashed border-border/60 bg-muted/20 p-12 text-center">
                <div className="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-primary/10">
                  <FolderOpen className="h-7 w-7 text-primary" />
                </div>
                <h2 className="text-lg sm:text-xl font-semibold text-foreground mb-2">
                  No assets found
                </h2>
                <p className="text-muted-foreground text-sm max-w-sm mx-auto mb-8">
                  {searchTerm
                    ? `Nothing matched "${searchTerm}". Try a different search term.`
                    : "No assets match this category. Try removing the filter."}
                </p>
                <div className="flex flex-col sm:flex-row items-center justify-center gap-3">
                  <Button variant="outline" onClick={clearAllFilters}>
                    Clear filters
                  </Button>
                  <a
                    href="https://wkf.ms/4mJslYK"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <Button
                      variant="outline"
                      className="gap-2 border-primary/30 text-primary hover:bg-primary/5"
                    >
                      <ExternalLink className="h-4 w-4" />
                      Request New Asset
                    </Button>
                  </a>
                </div>
              </div>
            ) : (
              <>
                {/* Asset grid */}
                <div
                  className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"
                  role="list"
                  aria-label="Asset library"
                >
                  {filteredItems.map((item: any) => (
                    <AssetCard
                      key={item.id}
                      item={item}
                      onSelect={() => setSelectedAsset(item)}
                      onShare={handleShare}
                      onDownload={handleDownload}
                    />
                  ))}
                </div>

                {/* Load More */}
                {hasNextPage && (
                  <div className="flex justify-center mt-8">
                    <Button
                      variant="outline"
                      onClick={() => fetchNextPage()}
                      disabled={isFetchingNextPage}
                      className="gap-2 min-h-[44px]"
                    >
                      {isFetchingNextPage ? (
                        <>
                          <span className="inline-block h-4 w-4 rounded-full border-2 border-primary/30 border-t-primary animate-spin" />
                          Loading...
                        </>
                      ) : (
                        "Load More Assets"
                      )}
                    </Button>
                  </div>
                )}
              </>
            )}
          </>
        )}
      </div>
    </div>
  );
}
