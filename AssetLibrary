  const preview = Array.isArray(f.preview) ? f.preview[0] : f.preview;
  const file = Array.isArray(f.file) ? f.file[0] : f.file;
  const subcategories = toSubArray(f.subcategories);
  const catLabel = labelOf(f.category);
  const catStyle = getCategoryStyle(catLabel);
  const CatIcon = catStyle.icon;
  const hasLink = !!f.publicLink;
  const hasFile = !!file?.url;
  const previewSource = getPreviewSource({
    preview,
    file,
    publicLink: f.publicLink,
    category: catLabel,
  });

  return (
    <div
      role="listitem"
      className="group rounded-xl border bg-card hover:border-primary/25 transition-all duration-200 cursor-pointer outline-none focus-within:ring-2 focus-within:ring-primary focus-within:ring-offset-2"
