const DEFAULT_CATEGORY = {
  bg: "bg-muted",
  text: "text-muted-foreground",
  border: "border-border/50",
  dot: "bg-muted-foreground",
  icon: FileText,
};

const getCategoryStyle = (label?: string) =>
  label ? CATEGORY_CONFIG[label] ?? DEFAULT_CATEGORY : DEFAULT_CATEGORY;

// ─── Helpers ───────────────────────────────────────────────────────────────────
const labelOf = (v: any): string => {
  if (!v) return "";
  if (typeof v === "string") return v;
  return v.label ?? v.name ?? v.value ?? "";
};

const toSubArray = (v: any): string[] => {
  if (!v) return [];
  if (Array.isArray(v)) return v.map(labelOf).filter(Boolean);
  const s = labelOf(v);
  return s ? [s] : [];
};

// ─── Clearable select (matches MessagingLibrary pattern) ───────────────────────
function ClearableSelect({
  label,
  value,
  onChange,
  onClear,
  options,
  placeholder,
}: {
  label: string;
  value: string;
  onChange: (v: string) => void;
  onClear: () => void;
  options: string[];
  placeholder: string;
}) {
  return (
    <div className="space-y-1.5">
      <label className="text-xs font-semibold uppercase tracking-wide text-muted-foreground">
        {label}
      </label>
      <div className="relative">
        <Select value={value} onValueChange={onChange}>
          <SelectTrigger className="w-full pr-9 bg-background border-border/70 h-9 text-sm">
            <SelectValue placeholder={placeholder} />
          </SelectTrigger>
          <SelectContent>
            {options.map((opt) => (
              <SelectItem key={opt} value={opt}>
                {opt}
              </SelectItem>
            ))}
          </SelectContent>
        </Select>
        {value && (
          <button
            type="button"
            onClick={(e) => {
              e.preventDefault();
              e.stopPropagation();
              onClear();
            }}
            className="absolute right-1.5 top-1/2 -translate-y-1/2 h-7 w-7 flex items-center justify-center rounded text-muted-foreground hover:text-foreground hover:bg-muted active:bg-muted/80 transition-colors duration-200"
            aria-label={`Clear ${label}`}
          >
            <X className="h-3.5 w-3.5" />
          </button>
        )}
      </div>
    </div>
  );
}

