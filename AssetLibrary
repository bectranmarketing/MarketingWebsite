        ) : (
          <div
            className={`shrink-0 h-16 w-24 sm:h-20 sm:w-28 rounded-lg border ${catStyle.border} ${catStyle.bg} flex items-center justify-center`}
          >
            <CatIcon className={`h-6 w-6 sm:h-7 sm:w-7 ${catStyle.text} opacity-70`} />
