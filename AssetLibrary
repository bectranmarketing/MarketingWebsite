        {/* Thumbnail */}
        {previewSource.type !== "none" ? (
          <div
            className="shrink-0 h-16 sm:h-20 rounded-lg overflow-hidden bg-muted max-w-[112px] sm:max-w-[136px]"
            style={{ aspectRatio: previewSource.aspectRatio }}
          >
            {previewSource.type === "image" ? (
              <img
                src={previewSource.url}
                alt={f.name || "Asset preview"}
                className="h-full w-full object-cover group-hover:scale-[1.03] transition-transform duration-500 ease-out"
                onError={(e) => {
                  (e.target as HTMLImageElement).style.display = "none";
                }}
              />
            ) : previewSource.type === "pdf" ? (
              <iframe
                title={f.name || "Asset preview"}
                src={`${previewSource.url}#page=1&zoom=page-fit&toolbar=0&navpanes=0&scrollbar=0`}
                className="h-full w-full border-0 pointer-events-none"
              />
            ) : previewSource.type === "office" ? (
              <iframe
                title={f.name || "Asset preview"}
                src={previewSource.url}
                className="h-full w-full border-0 pointer-events-none"
              />
