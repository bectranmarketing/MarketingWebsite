// Fallback palette for categories not in CATEGORY_CONFIG (future-proof)
const FALLBACK_COLORS = [
  { bg: "bg-teal-500/10",   text: "text-teal-700 dark:text-teal-300",   border: "border-teal-500/20",   dot: "bg-teal-500" },
  { bg: "bg-lime-500/10",   text: "text-lime-700 dark:text-lime-300",   border: "border-lime-500/20",   dot: "bg-lime-500" },
  { bg: "bg-fuchsia-500/10", text: "text-fuchsia-700 dark:text-fuchsia-300", border: "border-fuchsia-500/20", dot: "bg-fuchsia-500" },
  { bg: "bg-yellow-500/10", text: "text-yellow-700 dark:text-yellow-300", border: "border-yellow-500/20", dot: "bg-yellow-500" },
  { bg: "bg-red-500/10",    text: "text-red-700 dark:text-red-300",     border: "border-red-500/20",    dot: "bg-red-500" },
];

const DEFAULT_CATEGORY = {
  bg: "bg-muted",
  text: "text-muted-foreground",
  border: "border-border/50",
  dot: "bg-muted-foreground",
  icon: FileText,
};

const dynamicCategoryCache = new Map<string, typeof DEFAULT_CATEGORY>();

const getCategoryStyle = (label?: string) => {
  if (!label) return DEFAULT_CATEGORY;
  if (CATEGORY_CONFIG[label]) return CATEGORY_CONFIG[label];
  // Deterministic fallback color for unknown categories
  if (dynamicCategoryCache.has(label)) return dynamicCategoryCache.get(label)!;
  const hash = Array.from(label).reduce((acc, c) => acc + c.charCodeAt(0), 0);
  const palette = FALLBACK_COLORS[hash % FALLBACK_COLORS.length];
  const entry = { ...palette, icon: FileText };
  dynamicCategoryCache.set(label, entry);
  return entry;
};

// ─── Helpers ───────────────────────────────────────────────────────────────────
const labelOf = (v: any): string => {
  if (!v) return "";
  if (typeof v === "string") return v;
  return v.label ?? v.name ?? v.value ?? "";
};

const toSubArray = (v: any): string[] => {
  if (!v) return [];
  if (Array.isArray(v)) return v.map(labelOf).filter(Boolean);
  const s = labelOf(v);
  return s ? [s] : [];
};

const getFileExt = (name?: string): string => {
  if (!name) return "";
  const parts = name.toLowerCase().split(".");
  return parts.length > 1 ? parts.pop() || "" : "";
};

const getPreviewSource = ({
  preview,
  file,
  publicLink,
  category,
}: {
  preview: any;
  file: any;
  publicLink?: string;
  category?: string;
}) => {
  if (preview?.url) {
    return {
      type: "image" as const,
      url: preview.url,
      aspectRatio:
        preview?.width && preview?.height
          ? `${preview.width} / ${preview.height}`
          : category === "One Pager"
          ? "8.5 / 11"
          : "4 / 3",
    };
  }

  const fileUrl = file?.url || publicLink;
  const fileType = String(file?.type || "").toLowerCase();
  const fileExt = getFileExt(file?.name || file?.filename || publicLink);

  if (fileUrl) {
    const isImage =
      fileType.startsWith("image/") ||
      ["png", "jpg", "jpeg", "webp", "gif", "svg"].includes(fileExt);
    if (isImage) {
      return {
        type: "image" as const,
        url: fileUrl,
        aspectRatio: category === "One Pager" ? "8.5 / 11" : "4 / 3",
      };
    }

    const isPdf = fileType.includes("pdf") || fileExt === "pdf";
    if (isPdf) {
      return {
        type: "pdf" as const,
        url: fileUrl,
        aspectRatio: "8.5 / 11",
      };
    }

    const officeExts = ["ppt", "pptx", "doc", "docx", "xls", "xlsx"];
    const isOfficeDoc = officeExts.includes(fileExt);
    if (isOfficeDoc) {
      return {
        type: "office" as const,
        url: `https://view.officeapps.live.com/op/embed.aspx?src=${encodeURIComponent(fileUrl)}`,
        aspectRatio: fileExt.startsWith("ppt") ? "16 / 9" : "4 / 3",
      };
    }
  }

  return {
    type: "none" as const,
    url: "",
    aspectRatio: category === "One Pager" ? "8.5 / 11" : "4 / 3",
  };
};

