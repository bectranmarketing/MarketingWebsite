// ─── Main Component ────────────────────────────────────────────────────────────
export default function Block() {
  const [searchTerm, setSearchTerm] = useState("");
  const [selectedCategory, setSelectedCategory] = useState("");
  const [selectedSubcategory, setSelectedSubcategory] = useState("");
  const [filtersOpen, setFiltersOpen] = useState(false);
  const [selectedAsset, setSelectedAsset] = useState<any>(null);
  const [copiedLink, setCopiedLink] = useState<string | null>(null);
  const [sortField, setSortField] = useState<string>("name");
  const [sortOrder, setSortOrder] = useState<"asc" | "desc">("asc");
  const [page, setPage] = useState(0);
  const searchRef = useRef<HTMLInputElement>(null);

  // Quiz state
  const [quizOpen, setQuizOpen] = useState(false);
  const [quizStep, setQuizStep] = useState(0);
  const [quizAnswers, setQuizAnswers] = useState<Partial<Record<QuizId, string>>>({});
  const [quizAutoApplied, setQuizAutoApplied] = useState(false);
  const quizContainerRef = useRef<HTMLDivElement>(null);

  const { data, status, refetch } = useRecords({
    select,
    orderBy: sortOrder === "asc" ? q.asc(sortField) : q.desc(sortField),
    count: 100,
  });

  const items = useMemo(
    () => data?.pages.flatMap((page: any) => page.items) ?? [],
    [data]
  );

  // Always refetch once on page load to refresh expiring monday file URLs.
  useEffect(() => {
    refetch();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  // Derive unique category options from data (future-proof: driven by data)
  const categoryOptions = useMemo(() => {
    const set = new Set<string>();
    items.forEach((item: any) => {
      const label = labelOf(item.fields.category);
      if (label) set.add(label);
    });
    return Array.from(set).sort();
  }, [items]);

  // Derive subcategory options — filtered by selected category when one is active
  const subcategoryOptions = useMemo(() => {
    const set = new Set<string>();
    const source = selectedCategory
      ? items.filter((item: any) => labelOf(item.fields.category) === selectedCategory)
      : items;
    source.forEach((item: any) => {
      toSubArray(item.fields.subcategories).forEach((s) => set.add(s));
    });
    return Array.from(set).sort();
  }, [items, selectedCategory]);

  // When category changes, clear subcategory if it's no longer valid
  useEffect(() => {
    if (selectedSubcategory && !subcategoryOptions.includes(selectedSubcategory)) {
      setSelectedSubcategory("");
    }
  }, [subcategoryOptions, selectedSubcategory]);

  // Filter items
  const filteredItems = useMemo(() => {
    return items.filter((item: any) => {
      const f = item.fields;
      if (selectedCategory && labelOf(f.category) !== selectedCategory)
        return false;
      if (selectedSubcategory) {
        const subs = toSubArray(f.subcategories);
        if (!subs.includes(selectedSubcategory)) return false;
      }
      if (searchTerm) {
        const s = searchTerm.toLowerCase();
        const nameMatch = f.name?.toLowerCase().includes(s);
        const catMatch = labelOf(f.category)?.toLowerCase().includes(s);
        const descMatch = f.description?.toLowerCase().includes(s);
        const subMatch = toSubArray(f.subcategories).some((x) =>
          x.toLowerCase().includes(s)
        );
        if (!nameMatch && !catMatch && !descMatch && !subMatch) return false;
      }
      return true;
    });
  }, [items, searchTerm, selectedCategory, selectedSubcategory]);

  // Pagination
  const totalFiltered = filteredItems.length;
  const totalPages = Math.max(1, Math.ceil(totalFiltered / PAGE_SIZE));
  const safePage = Math.min(page, totalPages - 1);
  const pagedItems = filteredItems.slice(
    safePage * PAGE_SIZE,
    safePage * PAGE_SIZE + PAGE_SIZE
  );

  const activeFilterCount = [selectedCategory, selectedSubcategory].filter(
    Boolean
  ).length;
  const hasActiveFilters = !!(searchTerm || activeFilterCount);

  const clearAllFilters = () => {
    setSearchTerm("");
    setSelectedCategory("");
    setSelectedSubcategory("");
    setPage(0);
  };

  const handleSort = (field: string) => {
    if (sortField === field) {
      setSortOrder((o) => (o === "asc" ? "desc" : "asc"));
    } else {
      setSortField(field);
      setSortOrder(field === "datePublished" ? "desc" : "asc");
    }
    setPage(0);
  };

  const handleDownload = async (itemOrFile: any) => {
    const fallbackFile = itemOrFile?.fields
      ? Array.isArray(itemOrFile.fields.file)
        ? itemOrFile.fields.file[0]
        : itemOrFile.fields.file
      : itemOrFile;

    let latestUrl = fallbackFile?.url;

    if (itemOrFile?.id) {
      try {
        const refreshed: any = await refetch();
        const refreshedPages =
          refreshed?.pages ?? refreshed?.data?.pages ?? data?.pages ?? [];
        const refreshedItems = refreshedPages.flatMap((page: any) => page.items ?? []);
        const refreshedItem = refreshedItems.find((x: any) => x.id === itemOrFile.id);
        const refreshedFile = refreshedItem?.fields
          ? Array.isArray(refreshedItem.fields.file)
            ? refreshedItem.fields.file[0]
            : refreshedItem.fields.file
          : null;

        if (refreshedFile?.url) {
          latestUrl = refreshedFile.url;
        }
      } catch {
        // Fallback to the currently loaded URL if refetch fails.
      }
    }

    if (latestUrl) {
      window.open(latestUrl, "_blank");
      return;
    }

    toast.error("Download link is unavailable. Try refreshing the page.");
  };

  const copyLink = async (link: string) => {
    try {
      await navigator.clipboard.writeText(link);
      setCopiedLink(link);
      toast.success("Link copied!");
      setTimeout(() => setCopiedLink(null), 2000);
    } catch {
      toast.error("Failed to copy link");
    }
  };

  // ─── Quiz logic ─────────────────────────────────────────────────────────────
  const getQuizFieldValues = (item: any, qId: QuizId): string[] => {
    if (qId === "category") {
      const label = labelOf(item.fields.category);
      return label ? [label] : [];
    }
    return toSubArray(item.fields.subcategories);
  };

  const computeQuizFilteredRecords = (excludeId: QuizId | null = null) => {
    let filtered = [...items];
    quizQuestions.forEach((qq) => {
      if (excludeId && qq.id === excludeId) return;
      const selectedVal = quizAnswers[qq.id];
      if (!selectedVal) return;
      filtered = filtered.filter((item) => {
        return getQuizFieldValues(item, qq.id).some(
          (x) => x.toLowerCase() === selectedVal.toLowerCase()
        );
      });
    });
    return filtered;
  };

  const quizFilteredRecords = useMemo(
    () => computeQuizFilteredRecords(null),
    // eslint-disable-next-line react-hooks/exhaustive-deps
    [items, quizAnswers]
  );

  const quizAnswerCount = Object.values(quizAnswers).filter(Boolean).length;

  const computeQuizOptionsForStep = (stepIndex: number) => {
    const question = quizQuestions[stepIndex];
    const base = computeQuizFilteredRecords(question.id);
    const unique = new Map<string, string>();
    base.forEach((item) => {
      getQuizFieldValues(item, question.id).forEach((val) => {
        const label = String(val || "").trim();
        if (!label) return;
        const lower = label.toLowerCase();
        if (!unique.has(lower)) unique.set(lower, label);
      });
    });
    return Array.from(unique.values()).sort((a, b) => a.localeCompare(b));
  };

  const currentQuizQuestion = quizQuestions[quizStep];
  const currentQuizOptions = useMemo(() => {
    if (!quizOpen || status !== "success" || !currentQuizQuestion) return [];
    return computeQuizOptionsForStep(quizStep);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [quizOpen, status, quizStep, items, quizAnswers]);

  useEffect(() => {
    if (!quizOpen || status !== "success" || !currentQuizQuestion) return;
    const opts = currentQuizOptions;

    if (opts.length === 0) {
      if (quizStep < quizQuestions.length - 1) setQuizStep((s) => s + 1);
      return;
    }
    const already = quizAnswers[currentQuizQuestion.id];
    if (!already && opts.length === 1) {
      setQuizAnswers((prev) => ({ ...prev, [currentQuizQuestion.id]: opts[0] }));
      return;
    }
    if (quizFilteredRecords.length === 1 && !quizAutoApplied) {
      applyQuizNow();
      setQuizAutoApplied(true);
      setQuizOpen(false);
      return;
    }
    if (already && quizStep < quizQuestions.length - 1) {
      setQuizStep((s) => s + 1);
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [quizOpen, status, quizStep, currentQuizOptions, quizAnswers, quizFilteredRecords]);

  const openQuiz = () => {
    setQuizAnswers({});
    setQuizStep(0);
    setQuizAutoApplied(false);
    setQuizOpen(true);
    setTimeout(() => quizContainerRef.current?.focus(), 0);
  };

  const closeQuiz = () => setQuizOpen(false);

  const applyQuizNow = () => {
    setSelectedCategory(quizAnswers.category || "");
    setSelectedSubcategory(quizAnswers.subcategory || "");
    setQuizOpen(false);
    setPage(0);
  };

  const quizSelectAnswer = (opt: string) => {
    setQuizAnswers((prev) => ({ ...prev, [currentQuizQuestion.id]: opt }));
  };

  const quizBack = () => {
    if (quizStep > 0) setQuizStep((s) => s - 1);
  };

  const quizSkip = () => {
    if (quizStep < quizQuestions.length - 1) {
      setQuizStep((s) => s + 1);
    } else {
      applyQuizNow();
    }
  };

  // Close quiz on Escape
  useEffect(() => {
    if (!quizOpen) return;
    const handler = (e: KeyboardEvent) => {
      if (e.key === "Escape") closeQuiz();
    };
    document.addEventListener("keydown", handler);
    return () => document.removeEventListener("keydown", handler);
  }, [quizOpen]);

  // Close asset preview on Escape
  useEffect(() => {
    if (!selectedAsset) return;
    const handler = (e: KeyboardEvent) => {
      if (e.key === "Escape") setSelectedAsset(null);
    };
    document.addEventListener("keydown", handler);
    return () => document.removeEventListener("keydown", handler);
  }, [selectedAsset]);

  // Prevent any page/modal scroll while overlays are open
  useEffect(() => {
    const lockScroll = quizOpen || !!selectedAsset;
    if (!lockScroll) return;

    const htmlOverflow = document.documentElement.style.overflow;
    const bodyOverflow = document.body.style.overflow;
    document.documentElement.style.overflow = "hidden";
    document.body.style.overflow = "hidden";

    return () => {
      document.documentElement.style.overflow = htmlOverflow;
      document.body.style.overflow = bodyOverflow;
    };
  }, [quizOpen, selectedAsset]);

  // ─── Active filter chips ──────────────────────────────────────────────────
  const activeFilters: { label: string; value: string; clear: () => void }[] = [
    ...(selectedCategory
      ? [
          {
            label: "Category",
            value: selectedCategory,
            clear: () => { setSelectedCategory(""); setPage(0); },
          },
        ]
      : []),
    ...(selectedSubcategory
      ? [
          {
            label: "Subcategory",
            value: selectedSubcategory,
            clear: () => { setSelectedSubcategory(""); setPage(0); },
          },
        ]
      : []),
  ];

  const selectedAssetFields = selectedAsset?.fields;
  const selectedPreview = selectedAssetFields
    ? Array.isArray(selectedAssetFields.preview)
      ? selectedAssetFields.preview[0]
      : selectedAssetFields.preview
    : null;
  const selectedFile = selectedAssetFields
    ? Array.isArray(selectedAssetFields.file)
      ? selectedAssetFields.file[0]
      : selectedAssetFields.file
    : null;
  const selectedSubcategories = selectedAssetFields
    ? toSubArray(selectedAssetFields.subcategories)
    : [];
  const selectedCatLabel = selectedAssetFields
    ? labelOf(selectedAssetFields.category)
    : "";
  const selectedCatStyle = getCategoryStyle(selectedCatLabel);
  const SelectedCatIcon = selectedCatStyle.icon;
  const isSelectedCopied = copiedLink === selectedAssetFields?.publicLink;
  const selectedPreviewSource = getPreviewSource({
    preview: selectedPreview,
    file: selectedFile,
    publicLink: selectedAssetFields?.publicLink,
    category: selectedCatLabel,
  });

  // ─── List View ────────────────────────────────────────────────────────────
  if (status === "pending") {
    return (
      <div className="min-h-screen bg-background">
        <div className="max-w-5xl mx-auto px-3 sm:px-4 py-6 sm:py-10">
          <div className="mb-8">
            <h1 className="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">
              Marketing Assets
            </h1>
            <p className="mt-1.5 text-muted-foreground text-sm sm:text-base">
              View, download, and share Bectran marketing materials.
            </p>
          </div>
          <div className="space-y-3" role="status" aria-label="Loading assets">
            {[1, 2, 3, 4, 5].map((i) => (
              <SkeletonRow key={i} />
            ))}
          </div>
        </div>
      </div>
    );
  }

  if (status === "error") {
    return (
      <div className="min-h-screen bg-background flex items-center justify-center">
        <div className="text-center">
          <div className="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-destructive/10">
            <FileText className="h-7 w-7 text-destructive" />
          </div>
          <h2 className="text-lg font-semibold text-foreground mb-2">
            Error loading assets
          </h2>
          <p className="text-sm text-muted-foreground mb-6">
            Something went wrong. Please try again.
          </p>
          <Button
            variant="outline"
            onClick={() => window.location.reload()}
          >
            Reload Page
          </Button>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-background">
      <div className="max-w-5xl mx-auto px-3 sm:px-4 py-6 sm:py-10">
        {/* ── Page Header ─────────────────────────────────────────────────── */}
        <div className="mb-8">
          <div className="flex items-start justify-between gap-4">
            <div>
              <h1 className="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">
                Marketing Assets
              </h1>
              <p className="mt-1.5 text-muted-foreground text-sm sm:text-base">
                View, download, and share Bectran marketing materials.
              </p>
            </div>

          </div>
        </div>

        {/* ── Search + Filters toggle + Quiz CTA ───────────────────────────── */}
        <div className="flex gap-3 mb-4">
          <div className="relative flex-1">
            <Search className="absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground pointer-events-none" />
            <Input
              ref={searchRef}
              type="text"
              placeholder="Search by name, category, or description..."
              value={searchTerm}
              onChange={(e) => { setSearchTerm(e.target.value); setPage(0); }}
              className="pl-10 h-12 sm:h-11 text-base sm:text-sm bg-background"
            />
            {searchTerm && (
              <button
                type="button"
                className="absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground transition-colors"
                onClick={() => { setSearchTerm(""); setPage(0); }}
                aria-label="Clear search"
              >
                <X className="h-4 w-4" />
              </button>
            )}
          </div>
          <Button
            variant={filtersOpen ? "secondary" : "outline"}
            onClick={() => setFiltersOpen((v) => !v)}
            className="h-12 sm:h-11 gap-2 shrink-0"
            type="button"
          >
            <SlidersHorizontal className="h-4 w-4" />
            <span className="hidden sm:inline">Filters</span>
            {activeFilterCount > 0 && (
              <span className="ml-0.5 flex h-5 w-5 items-center justify-center rounded-full bg-white/20 text-xs font-semibold">
                {activeFilterCount}
              </span>
            )}
          </Button>

          {/* Quiz CTA */}
          <Button
            variant="outline"
            onClick={openQuiz}
            className="h-12 sm:h-11 gap-2 shrink-0 text-muted-foreground"
          >
            <Wand2 className="h-4 w-4" />
            <span className="hidden sm:inline">Find by Quiz</span>
          </Button>
        </div>

        {/* ── Filter Panel (collapsible) ──────────────────────────────────── */}
        {filtersOpen && (
          <div className="mb-4 p-4 rounded-xl border bg-muted/30 animate-in fade-in-0 slide-in-from-top-2 duration-200">
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <ClearableSelect
                label="Category (Type)"
                value={selectedCategory}
                onChange={(v) => { setSelectedCategory(v); setPage(0); }}
                onClear={() => { setSelectedCategory(""); setPage(0); }}
                options={categoryOptions}
                placeholder="All categories"
              />
              <ClearableSelect
                label="Subcategory (Topic)"
                value={selectedSubcategory}
                onChange={(v) => { setSelectedSubcategory(v); setPage(0); }}
                onClear={() => { setSelectedSubcategory(""); setPage(0); }}
                options={subcategoryOptions}
                placeholder={selectedCategory ? `Topics in ${selectedCategory}` : "All subcategories"}
              />
            </div>
          </div>
        )}

        {/* ── Active filter chips + clear all ─────────────────────────────── */}
        {activeFilters.length > 0 && (
          <div className="flex flex-wrap items-center gap-2 mb-4">
            {activeFilters.map((f) => (
              <span
                key={f.label}
                className="inline-flex items-center gap-1.5 pl-3 pr-1.5 py-1 rounded-full bg-primary/10 text-primary text-xs font-medium border border-primary/20"
              >
                <span className="opacity-70">{f.label}:</span>
                <span>{f.value}</span>
                <button
                  onClick={f.clear}
                  className="h-5 w-5 flex items-center justify-center rounded-full hover:bg-primary/20 active:bg-primary/30 transition-colors"
                  aria-label={`Remove ${f.label} filter`}
                >
                  <X className="h-3 w-3" />
                </button>
              </span>
            ))}
            <button
              onClick={clearAllFilters}
              className="text-xs text-muted-foreground hover:text-foreground underline-offset-2 hover:underline transition-colors ml-1 py-1.5 px-1"
            >
              Clear all
            </button>
          </div>
        )}

        {/* ── Results header + sort ────────────────────────────────────── */}
        <div className="flex items-center justify-between mb-3 px-1">
          <p className="text-xs text-muted-foreground">
            {totalFiltered} {totalFiltered === 1 ? "asset" : "assets"}
            {totalPages > 1 && (
              <span>
                {" · "}page {safePage + 1} of {totalPages}
              </span>
            )}
          </p>
          <div className="flex items-center gap-4">
            <SortButton
              label="Name"
              field="name"
              active={sortField === "name"}
              order={sortOrder}
              onClick={() => handleSort("name")}
            />
            <SortButton
              label="Category"
              field="category"
              active={sortField === "category"}
              order={sortOrder}
              onClick={() => handleSort("category")}
            />
            <SortButton
              label="Date"
              field="datePublished"
              active={sortField === "datePublished"}
              order={sortOrder}
              onClick={() => handleSort("datePublished")}
            />
          </div>
        </div>

        {/* ── Asset List ──────────────────────────────────────────────────── */}
        {totalFiltered === 0 ? (
          <div className="mt-4 rounded-2xl border-2 border-dashed border-border/60 bg-muted/20 p-12 text-center">
            <div className="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-primary/10">
              <FolderOpen className="h-7 w-7 text-primary" />
            </div>
            <h2 className="text-xl font-semibold text-foreground mb-2">
              No assets found
            </h2>
            <p className="text-muted-foreground text-sm max-w-sm mx-auto mb-8">
              {searchTerm
                ? `Nothing matched "${searchTerm}". Try a different search term.`
                : "No assets match the current filters. Try adjusting them."}
            </p>
            <div className="flex flex-col sm:flex-row items-center justify-center gap-3">
              <Button variant="outline" onClick={clearAllFilters}>
                Clear filters
              </Button>
              <Button
                variant="outline"
                onClick={openQuiz}
                className="gap-2 border-primary/30 text-primary hover:bg-primary/5"
              >
                <Wand2 className="h-4 w-4" />
                Try the Quiz
              </Button>
              <a
                href="https://wkf.ms/4mJslYK"
                target="_blank"
                rel="noopener noreferrer"
              >
                <Button
                  variant="outline"
                  className="gap-2 border-primary/30 text-primary hover:bg-primary/5"
                >
                  <ExternalLink className="h-4 w-4" />
                  Request New Asset
                </Button>
              </a>
            </div>
          </div>
        ) : (
          <>
            <div className="space-y-2" role="list" aria-label="Asset library">
              {pagedItems.map((item: any) => (
                <AssetRow
                  key={item.id}
                  item={item}
                  onSelect={() => setSelectedAsset(item)}
                  onDownload={handleDownload}
                />
              ))}
            </div>

            {/* ── Pagination controls ──────────────────────────────────────── */}
            {totalPages > 1 && (
              <nav aria-label="Pagination" className="flex items-center justify-center gap-2 mt-6">
                <Button
                  variant="outline"
                  size="sm"
                  disabled={safePage === 0}
                  onClick={() => setPage((p) => Math.max(0, p - 1))}
                  className="gap-1.5 h-9"
                >
                  <ChevronLeft className="h-4 w-4" />
                  Previous
                </Button>
                <div className="flex items-center gap-1">
                  {Array.from({ length: totalPages }, (_, i) => i)
                    .filter((i) => {
                      if (totalPages <= 7) return true;
                      if (i === 0 || i === totalPages - 1) return true;
                      if (Math.abs(i - safePage) <= 1) return true;
                      return false;
                    })
                    .reduce<(number | "ellipsis")[]>((acc, i, idx, arr) => {
                      if (idx > 0 && i - (arr[idx - 1] as number) > 1) {
                        acc.push("ellipsis");
                      }
                      acc.push(i);
                      return acc;
                    }, [])
                    .map((item, idx) =>
                      item === "ellipsis" ? (
                        <span
                          key={`ellipsis-${idx}`}
                          className="px-1 text-xs text-muted-foreground"
                        >
                          ...
                        </span>
                      ) : (
                        <button
                          key={item}
                          type="button"
                          onClick={() => setPage(item)}
                          aria-current={safePage === item ? "page" : undefined}
                          className={`h-9 min-w-[36px] px-2 rounded-lg text-sm font-medium transition-colors ${
                            safePage === item
                              ? "bg-primary text-primary-foreground shadow-sm"
                              : "text-muted-foreground hover:bg-muted hover:text-foreground"
                          }`}
                        >
                          {item + 1}
                        </button>
                      )
                    )}
                </div>
                <Button
                  variant="outline"
                  size="sm"
                  disabled={safePage >= totalPages - 1}
                  onClick={() =>
                    setPage((p) => Math.min(totalPages - 1, p + 1))
                  }
                  className="gap-1.5 h-9"
                >
                  Next
                  <ChevronRight className="h-4 w-4" />
                </Button>
              </nav>
            )}
          </>
        )}

        {/* ── Quiz Modal ──────────────────────────────────────────────────── */}
        {quizOpen && (
          <div className="fixed inset-0 z-50">
            {/* Backdrop */}
            <div
              className="absolute inset-0 bg-black/40 backdrop-blur-sm animate-in fade-in-0 duration-150"
              onClick={closeQuiz}
              aria-hidden="true"
            />

            {/* Modal */}
            <div className="absolute inset-0 flex items-center justify-center p-4">
              <div
                ref={quizContainerRef}
                tabIndex={-1}
                role="dialog"
                aria-modal="true"
                aria-label="Find the right asset"
                className="w-full max-w-xl rounded-2xl bg-background shadow-2xl border border-border outline-none animate-in fade-in-0 zoom-in-95 duration-200 overflow-hidden"
                onClick={(e) => e.stopPropagation()}
              >
                {/* Progress bar */}
                <div className="h-1 w-full bg-muted">
                  <div
                    className="h-full bg-primary transition-all duration-300"
                    style={{ width: `${((quizStep + 1) / quizQuestions.length) * 100}%` }}
                  />
                </div>

                {/* Header */}
                <div className="px-6 pt-5 pb-4 border-b border-border/60">
                  <div className="flex items-center justify-between gap-3">
                    <div className="min-w-0">
                      <div className="flex items-center gap-2 mb-1">
                        <span className="text-xs font-semibold text-muted-foreground uppercase tracking-wide">
                          Step {quizStep + 1} of {quizQuestions.length}
                        </span>
                        {quizFilteredRecords.length > 0 && (
                          <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-500/20 text-xs font-medium">
                            <span className="font-bold">{quizFilteredRecords.length}</span> match{quizFilteredRecords.length !== 1 ? "es" : ""}
                          </span>
                        )}
                      </div>
                      <h2 className="text-xl font-bold text-foreground">Find the right asset</h2>
                    </div>
                    <button
                      type="button"
                      onClick={closeQuiz}
                      className="h-9 w-9 flex items-center justify-center rounded-lg hover:bg-muted text-muted-foreground hover:text-foreground transition-colors"
                      aria-label="Close"
                    >
                      <X className="h-4 w-4" />
                    </button>
                  </div>

                  {/* Selection chips */}
                  {quizAnswerCount > 0 && (
                    <div className="flex flex-wrap gap-1.5 mt-3">
                      {quizQuestions.map((qq) => {
                        const v = quizAnswers[qq.id];
                        if (!v) return null;
                        return (
                          <span
                            key={qq.id}
                            className="inline-flex items-center gap-1.5 pl-2.5 pr-1.5 py-1 rounded-full bg-primary/10 border border-primary/20 text-xs"
                          >
                            <span className="text-muted-foreground">{qq.chipLabel}:</span>
                            <span className="font-semibold text-primary">{v}</span>
                            <button
                              type="button"
                              onClick={() => {
                                setQuizAnswers((prev) => { const n = { ...prev }; delete (n as any)[qq.id]; return n; });
                                const idx = quizQuestions.findIndex((x) => x.id === qq.id);
                                if (idx >= 0) setQuizStep(idx);
                              }}
                              className="h-5 w-5 flex items-center justify-center rounded-full hover:bg-primary/20 active:bg-primary/30 text-primary transition-colors"
                              aria-label={`Clear ${qq.chipLabel}`}
                            >
                              <X className="h-3 w-3" />
                            </button>
                          </span>
                        );
                      })}
                    </div>
                  )}
                </div>

                {/* Body */}
                <div className="px-6 py-6">
                  <div className="mb-5">
                    <h3 className="text-2xl font-bold text-foreground">{currentQuizQuestion?.title}</h3>
                    {currentQuizQuestion?.subtitle && (
                      <p className="text-sm text-muted-foreground mt-1">{currentQuizQuestion.subtitle}</p>
                    )}
                    {currentQuizQuestion?.optional && (
                      <span className="inline-block mt-2 text-xs text-muted-foreground border border-border/60 px-2 py-0.5 rounded-full">
                        Optional
                      </span>
                    )}
                  </div>

                  {status === "pending" ? (
                    <div className="space-y-2">
                      {[1, 2, 3].map((i) => (
                        <div key={i} className="h-14 rounded-xl bg-muted animate-pulse" />
                      ))}
                    </div>
                  ) : !Array.isArray(currentQuizOptions) || currentQuizOptions.length === 0 ? (
                    <div className="text-center py-8 text-muted-foreground text-sm">
                      No options available — skipping this step...
                    </div>
                  ) : (
                    <div className="grid gap-2 max-h-[50vh] overflow-y-auto">
                      {currentQuizOptions.map((opt) => {
                        const isSelected = quizAnswers[currentQuizQuestion.id] === opt;
                        return (
                          <button
                            key={opt}
                            type="button"
                            onClick={() => quizSelectAnswer(opt)}
                            className={`w-full text-left px-4 py-3.5 rounded-xl border text-sm font-medium transition-all duration-200 outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-1 active:scale-[0.98] min-h-[44px]
                              ${isSelected
                                ? "border-primary bg-primary/5 text-primary ring-1 ring-primary/30"
                                : "border-border bg-background text-foreground hover:border-primary/40 hover:bg-muted/40"
                              }`}
                          >
                            <div className="flex items-center justify-between">
                              <span>{opt}</span>
                              {isSelected && (
                                <span className="flex h-5 w-5 items-center justify-center rounded-full bg-primary text-primary-foreground">
                                  <Check className="h-3 w-3" />
                                </span>
                              )}
                            </div>
                          </button>
                        );
                      })}
                    </div>
                  )}
                </div>

                {/* Footer */}
                <div className="px-6 py-4 border-t border-border/60 bg-muted/20 flex items-center justify-between gap-3">
                  <div className="flex items-center gap-2">
                    <Button variant="outline" size="sm" onClick={quizBack} disabled={quizStep === 0} className="gap-1.5">
                      <ChevronLeft className="h-4 w-4" />
                      Back
                    </Button>
                    <Button
                      variant="ghost"
                      size="sm"
                      onClick={() => { setQuizAnswers({}); setQuizStep(0); setQuizAutoApplied(false); }}
                      className="text-muted-foreground"
                    >
                      Reset
                    </Button>
                  </div>

                  <div className="flex items-center gap-2">
                    {quizAnswerCount > 0 && (
                      <Button variant="outline" size="sm" onClick={applyQuizNow} className="border-primary/30 text-primary hover:bg-primary/5">
                        Apply filters
                      </Button>
                    )}
                    <Button size="sm" onClick={quizSkip} className="gap-1.5">
                      {quizStep === quizQuestions.length - 1 ? "Finish" : "Skip"}
                      <ChevronRight className="h-4 w-4" />
                    </Button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* ── Asset Preview Modal ─────────────────────────────────────────── */}
        {selectedAssetFields && (
          <div className="fixed inset-0 z-50">
            <div
              className="absolute inset-0 bg-black/40 backdrop-blur-sm animate-in fade-in-0 duration-150"
              onClick={() => setSelectedAsset(null)}
              aria-hidden="true"
            />

            <div className="absolute inset-0 flex items-center justify-center p-4">
              <div
                role="dialog"
                aria-modal="true"
                aria-label={selectedAssetFields.name || "Asset preview"}
                className="w-full max-w-5xl rounded-2xl bg-background shadow-2xl border border-border outline-none animate-in fade-in-0 zoom-in-95 duration-200 overflow-hidden flex flex-col"
                onClick={(e) => e.stopPropagation()}
              >
                <div className="flex items-center justify-between gap-3 px-5 py-4 border-b border-border/60">
                  <h2 className="text-base sm:text-lg font-semibold text-foreground truncate">
                    {selectedAssetFields.name || "Untitled Asset"}
                  </h2>
                  <button
                    type="button"
                    onClick={() => setSelectedAsset(null)}
                    className="h-9 w-9 flex items-center justify-center rounded-lg hover:bg-muted text-muted-foreground hover:text-foreground transition-colors"
                    aria-label="Close preview"
                  >
                    <X className="h-4 w-4" />
                  </button>
                </div>

                <div className="p-5 sm:p-6 overflow-hidden">
                  {selectedPreviewSource.type !== "none" ? (
                    <div className="w-full rounded-xl border bg-muted/40 p-3 sm:p-4 mb-5">
                      <div
                        className="mx-auto max-h-[52vh] w-auto"
                        style={{ aspectRatio: selectedPreviewSource.aspectRatio }}
                      >
                        {selectedPreviewSource.type === "image" ? (
                          <img
                            src={selectedPreviewSource.url}
                            alt={selectedPreview?.filename || selectedAssetFields.name}
                            className="h-full w-full object-contain rounded-lg"
                          />
                        ) : selectedPreviewSource.type === "pdf" ? (
                          <iframe
                            title={selectedAssetFields.name || "Asset preview"}
                            src={`${selectedPreviewSource.url}#page=1&zoom=page-fit&toolbar=0&navpanes=0&scrollbar=0`}
                            className="h-full w-full rounded-lg border-0"
                          />
                        ) : selectedPreviewSource.type === "office" ? (
                          <iframe
                            title={selectedAssetFields.name || "Asset preview"}
                            src={selectedPreviewSource.url}
                            className="h-full w-full rounded-lg border-0"
                          />
                        ) : null}
                      </div>
                    </div>
                  ) : (
                    <div className="h-56 bg-muted/40 rounded-xl border flex flex-col items-center justify-center gap-3 mb-5">
                      <div
                        className={`h-16 w-16 rounded-xl border ${selectedCatStyle.border} ${selectedCatStyle.bg} flex items-center justify-center`}
                      >
                        <SelectedCatIcon className={`h-8 w-8 ${selectedCatStyle.text}`} />
                      </div>
                      <span className="text-sm text-muted-foreground/60 font-medium">
                        {selectedCatLabel || "Asset"}
                      </span>
                    </div>
                  )}

                  <div className="flex flex-wrap items-center gap-2 mb-3">
                    {selectedCatLabel && (
                      <Badge
                        variant="outline"
                        className={`text-xs font-medium ${selectedCatStyle.bg} ${selectedCatStyle.text} ${selectedCatStyle.border}`}
                      >
                        {selectedCatLabel}
                      </Badge>
                    )}
                    {selectedSubcategories.map((sub, idx) => (
                      <Badge key={idx} variant="outline" className="text-xs">
                        {sub}
                      </Badge>
                    ))}
                  </div>

                  {selectedAssetFields.description && (
                    <p className="text-sm text-muted-foreground leading-relaxed mb-5 line-clamp-3">
                      {selectedAssetFields.description}
                    </p>
                  )}

                  <div className="flex flex-wrap gap-3">
                    {selectedAssetFields.publicLink && (
                      <Button
                        onClick={() => window.open(selectedAssetFields.publicLink, "_blank")}
                        className="gap-2 min-h-[42px]"
                      >
                        <ExternalLink className="h-4 w-4" />
                        Open Link
                      </Button>
                    )}
                    {selectedFile?.url && (
                      <Button
                        variant="outline"
                        onClick={() => handleDownload(selectedAsset)}
                        className="gap-2 min-h-[42px]"
                      >
                        <Download className="h-4 w-4" />
                        Download File
                      </Button>
                    )}
                    {selectedAssetFields.publicLink && (
                      <Button
                        variant="ghost"
                        onClick={() => copyLink(selectedAssetFields.publicLink)}
                        className={`gap-2 min-h-[42px] ${isSelectedCopied ? "text-emerald-600 hover:text-emerald-700" : ""}`}
                      >
                        {isSelectedCopied ? (
                          <>
                            <Check className="h-4 w-4" /> Copied
                          </>
                        ) : (
                          <>
                            <Copy className="h-4 w-4" /> Copy Link
                          </>
                        )}
                      </Button>
                    )}
                  </div>
                </div>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}
