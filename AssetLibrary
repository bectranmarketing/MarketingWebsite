// ─── Main Component ────────────────────────────────────────────────────────────
export default function Block() {
  const [searchTerm, setSearchTerm] = useState("");
  const [selectedCategory, setSelectedCategory] = useState("");
  const [selectedSubcategory, setSelectedSubcategory] = useState("");
  const [filtersOpen, setFiltersOpen] = useState(false);
  const [selectedAsset, setSelectedAsset] = useState<any>(null);
  const [copiedLink, setCopiedLink] = useState<string | null>(null);
  const [sortField, setSortField] = useState<string>("name");
  const [sortOrder, setSortOrder] = useState<"asc" | "desc">("asc");
  const [page, setPage] = useState(0);
  const searchRef = useRef<HTMLInputElement>(null);

  const { data, status } = useRecords({
    select,
    orderBy: sortOrder === "asc" ? q.asc(sortField) : q.desc(sortField),
    count: 100,
  });

  const items = useMemo(
    () => data?.pages.flatMap((page: any) => page.items) ?? [],
    [data]
  );

  // Derive unique category options from data
  const categoryOptions = useMemo(() => {
    const set = new Set<string>();
    items.forEach((item: any) => {
      const label = labelOf(item.fields.category);
      if (label) set.add(label);
    });
    return Array.from(set).sort();
  }, [items]);

  // Derive unique subcategory options from data
  const subcategoryOptions = useMemo(() => {
    const set = new Set<string>();
    items.forEach((item: any) => {
      toSubArray(item.fields.subcategories).forEach((s) => set.add(s));
    });
    return Array.from(set).sort();
  }, [items]);

  // Filter items
  const filteredItems = useMemo(() => {
    return items.filter((item: any) => {
      const f = item.fields;
      if (selectedCategory && labelOf(f.category) !== selectedCategory)
        return false;
      if (selectedSubcategory) {
        const subs = toSubArray(f.subcategories);
        if (!subs.includes(selectedSubcategory)) return false;
      }
      if (searchTerm) {
        const s = searchTerm.toLowerCase();
        const nameMatch = f.name?.toLowerCase().includes(s);
        const catMatch = labelOf(f.category)?.toLowerCase().includes(s);
        const descMatch = f.description?.toLowerCase().includes(s);
        const subMatch = toSubArray(f.subcategories).some((x) =>
          x.toLowerCase().includes(s)
        );
        if (!nameMatch && !catMatch && !descMatch && !subMatch) return false;
      }
      return true;
    });
  }, [items, searchTerm, selectedCategory, selectedSubcategory]);

  // Pagination
  const totalFiltered = filteredItems.length;
  const totalPages = Math.max(1, Math.ceil(totalFiltered / PAGE_SIZE));
  const safePage = Math.min(page, totalPages - 1);
  const pagedItems = filteredItems.slice(
    safePage * PAGE_SIZE,
    safePage * PAGE_SIZE + PAGE_SIZE
  );

  const activeFilterCount = [selectedCategory, selectedSubcategory].filter(
    Boolean
  ).length;
  const hasActiveFilters = !!(searchTerm || activeFilterCount);

  const clearAllFilters = () => {
    setSearchTerm("");
    setSelectedCategory("");
    setSelectedSubcategory("");
    setPage(0);
  };

  const handleSort = (field: string) => {
    if (sortField === field) {
      setSortOrder((o) => (o === "asc" ? "desc" : "asc"));
    } else {
      setSortField(field);
      setSortOrder("asc");
    }
    setPage(0);
  };

  const handleDownload = (file: any) => {
    if (file?.url) window.open(file.url, "_blank");
  };

  const copyLink = async (link: string) => {
    try {
      await navigator.clipboard.writeText(link);
      setCopiedLink(link);
      toast.success("Link copied!");
      setTimeout(() => setCopiedLink(null), 2000);
    } catch {
      toast.error("Failed to copy link");
    }
  };

  // ─── Active filter chips ──────────────────────────────────────────────────
  const activeFilters: { label: string; value: string; clear: () => void }[] = [
    ...(selectedCategory
      ? [
          {
            label: "Category",
            value: selectedCategory,
            clear: () => { setSelectedCategory(""); setPage(0); },
          },
        ]
      : []),
    ...(selectedSubcategory
      ? [
          {
            label: "Subcategory",
            value: selectedSubcategory,
            clear: () => { setSelectedSubcategory(""); setPage(0); },
          },
        ]
      : []),
  ];

  // ─── Detail View ──────────────────────────────────────────────────────────
  if (selectedAsset) {
    const f = selectedAsset.fields;
    const preview = Array.isArray(f.preview) ? f.preview[0] : f.preview;
    const file = Array.isArray(f.file) ? f.file[0] : f.file;
    const subcategories = toSubArray(f.subcategories);
    const catLabel = labelOf(f.category);
    const catStyle = getCategoryStyle(catLabel);
    const CatIcon = catStyle.icon;
    const isCopied = copiedLink === f.publicLink;

    return (
      <div className="min-h-screen bg-background">
        <div className="max-w-5xl mx-auto px-3 sm:px-4 py-6 sm:py-10">
          {/* Back nav */}
          <button
            onClick={() => setSelectedAsset(null)}
            className="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground mb-6 py-1.5 transition-colors duration-200 group outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 rounded"
          >
            <ArrowLeft className="h-4 w-4 group-hover:-translate-x-0.5 transition-transform" />
            Back to assets
          </button>

          {/* Asset detail card */}
          <div className="rounded-xl border bg-card overflow-hidden shadow-sm">
            {/* Preview image */}
            {preview?.url ? (
              <div className="relative bg-muted">
                <img
                  src={preview.url}
                  alt={preview.filename || f.name}
                  className="w-full max-h-[480px] object-contain mx-auto"
                />
              </div>
            ) : (
              <div className="h-48 bg-muted/40 flex flex-col items-center justify-center gap-3">
                <div
                  className={`h-16 w-16 rounded-xl border ${catStyle.border} ${catStyle.bg} flex items-center justify-center`}
                >
                  <CatIcon className={`h-8 w-8 ${catStyle.text}`} />
                </div>
                <span className="text-sm text-muted-foreground/60 font-medium">
                  {catLabel || "Asset"}
                </span>
              </div>
            )}

            <div className="p-5 sm:p-8">
              {/* Category + Subcategories */}
              <div className="flex flex-wrap items-center gap-2 mb-4">
                {catLabel && (
                  <Badge
                    variant="outline"
                    className={`text-xs font-medium ${catStyle.bg} ${catStyle.text} ${catStyle.border}`}
                  >
                    {catLabel}
                  </Badge>
                )}
                {subcategories.map((sub, idx) => (
                  <Badge key={idx} variant="outline" className="text-xs">
                    {sub}
                  </Badge>
                ))}
              </div>

              {/* Title */}
              <h2 className="text-xl sm:text-2xl font-bold text-foreground mb-3 leading-tight">
                {f.name || "Untitled Asset"}
              </h2>

              {/* Description */}
              {f.description && (
                <p className="text-sm text-muted-foreground leading-relaxed mb-6 max-w-2xl">
                  {f.description}
                </p>
              )}

              {/* Action buttons */}
              <div className="flex flex-wrap gap-3 pt-2">
                {f.publicLink && (
                  <Button
                    onClick={() => window.open(f.publicLink, "_blank")}
                    className="gap-2 min-h-[44px]"
                  >
                    <ExternalLink className="h-4 w-4" />
                    Open Link
                  </Button>
                )}
                {file?.url && (
                  <Button
                    variant="outline"
                    onClick={() => handleDownload(file)}
                    className="gap-2 min-h-[44px]"
                  >
                    <Download className="h-4 w-4" />
                    Download File
                  </Button>
                )}
                {f.publicLink && (
                  <Button
                    variant="ghost"
                    onClick={() => copyLink(f.publicLink)}
                    className={`gap-2 min-h-[44px] transition-all duration-200 ${
                      isCopied
                        ? "text-emerald-600 hover:text-emerald-700"
                        : ""
                    }`}
                  >
                    {isCopied ? (
                      <>
                        <Check className="h-4 w-4" /> Copied
                      </>
                    ) : (
                      <>
                        <Copy className="h-4 w-4" /> Copy Link
                      </>
                    )}
                  </Button>
                )}
              </div>
            </div>
          </div>
        </div>
      </div>
    );
  }

  // ─── List View ────────────────────────────────────────────────────────────
  if (status === "pending") {
    return (
      <div className="min-h-screen bg-background">
        <div className="max-w-5xl mx-auto px-3 sm:px-4 py-6 sm:py-10">
          <div className="mb-8">
            <h1 className="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">
              Marketing Assets
            </h1>
            <p className="mt-1.5 text-muted-foreground text-sm sm:text-base">
              View, download, and share Bectran marketing materials.
            </p>
          </div>
          <div className="space-y-3" role="status" aria-label="Loading assets">
            {[1, 2, 3, 4, 5].map((i) => (
              <SkeletonRow key={i} />
            ))}
          </div>
        </div>
      </div>
    );
  }

  if (status === "error") {
    return (
      <div className="min-h-screen bg-background flex items-center justify-center">
        <div className="text-center">
          <div className="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-destructive/10">
            <FileText className="h-7 w-7 text-destructive" />
          </div>
          <h2 className="text-lg font-semibold text-foreground mb-2">
            Error loading assets
          </h2>
          <p className="text-sm text-muted-foreground mb-6">
            Something went wrong. Please try again.
          </p>
          <Button
            variant="outline"
            onClick={() => window.location.reload()}
          >
            Reload Page
          </Button>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-background">
      <div className="max-w-5xl mx-auto px-3 sm:px-4 py-6 sm:py-10">
        {/* ── Page Header ─────────────────────────────────────────────────── */}
        <div className="mb-8">
          <div className="flex items-start justify-between gap-4">
            <div>
              <h1 className="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">
                Marketing Assets
              </h1>
              <p className="mt-1.5 text-muted-foreground text-sm sm:text-base">
                View, download, and share Bectran marketing materials.
              </p>
            </div>
            <a
              href="https://wkf.ms/4mJslYK"
              target="_blank"
              rel="noopener noreferrer"
              className="shrink-0"
            >
              <Button className="gap-2 hidden sm:inline-flex">
                <ExternalLink className="h-4 w-4" />
                Request New Asset
              </Button>
              <Button size="icon" className="h-10 w-10 sm:hidden">
                <ExternalLink className="h-4 w-4" />
              </Button>
            </a>
          </div>
        </div>

        {/* ── Search + Filters toggle ─────────────────────────────────────── */}
        <div className="flex gap-3 mb-4">
          <div className="relative flex-1">
            <Search className="absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground pointer-events-none" />
            <Input
              ref={searchRef}
              type="text"
              placeholder="Search by name, category, or description..."
              value={searchTerm}
              onChange={(e) => { setSearchTerm(e.target.value); setPage(0); }}
              className="pl-10 h-12 sm:h-11 text-base sm:text-sm bg-background"
            />
            {searchTerm && (
              <button
                type="button"
                className="absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground transition-colors"
                onClick={() => { setSearchTerm(""); setPage(0); }}
                aria-label="Clear search"
              >
                <X className="h-4 w-4" />
              </button>
            )}
          </div>
          <Button
            variant={filtersOpen ? "default" : "outline"}
            onClick={() => setFiltersOpen((v) => !v)}
            className="h-12 sm:h-11 gap-2 shrink-0"
            type="button"
          >
            <SlidersHorizontal className="h-4 w-4" />
            Filters
            {activeFilterCount > 0 && (
              <span className="ml-0.5 flex h-5 w-5 items-center justify-center rounded-full bg-white/20 text-xs font-semibold">
                {activeFilterCount}
              </span>
            )}
          </Button>
        </div>

        {/* ── Filter Panel (collapsible) ──────────────────────────────────── */}
        {filtersOpen && (
          <div className="mb-4 p-4 rounded-xl border bg-muted/30 animate-in fade-in-0 slide-in-from-top-2 duration-200">
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <ClearableSelect
                label="Category (Type)"
                value={selectedCategory}
                onChange={(v) => { setSelectedCategory(v); setPage(0); }}
                onClear={() => { setSelectedCategory(""); setPage(0); }}
                options={categoryOptions}
                placeholder="All categories"
              />
              <ClearableSelect
                label="Subcategory (Topic)"
                value={selectedSubcategory}
                onChange={(v) => { setSelectedSubcategory(v); setPage(0); }}
                onClear={() => { setSelectedSubcategory(""); setPage(0); }}
                options={subcategoryOptions}
                placeholder="All subcategories"
              />
            </div>
          </div>
        )}

        {/* ── Active filter chips + clear all ─────────────────────────────── */}
        {activeFilters.length > 0 && (
          <div className="flex flex-wrap items-center gap-2 mb-4">
            {activeFilters.map((f) => (
              <span
                key={f.label}
                className="inline-flex items-center gap-1.5 pl-3 pr-1.5 py-1 rounded-full bg-primary/10 text-primary text-xs font-medium border border-primary/20"
              >
                <span className="opacity-70">{f.label}:</span>
                <span>{f.value}</span>
                <button
                  onClick={f.clear}
                  className="h-5 w-5 flex items-center justify-center rounded-full hover:bg-primary/20 active:bg-primary/30 transition-colors"
                  aria-label={`Remove ${f.label} filter`}
                >
                  <X className="h-3 w-3" />
                </button>
              </span>
            ))}
            <button
              onClick={clearAllFilters}
              className="text-xs text-muted-foreground hover:text-foreground underline-offset-2 hover:underline transition-colors ml-1 py-1.5 px-1"
            >
              Clear all
            </button>
          </div>
        )}

        {/* ── Results header + sort ────────────────────────────────────── */}
        <div className="flex items-center justify-between mb-3 px-1">
          <p className="text-xs text-muted-foreground">
            {totalFiltered} {totalFiltered === 1 ? "asset" : "assets"}
            {totalPages > 1 && (
              <span>
                {" · "}page {safePage + 1} of {totalPages}
              </span>
            )}
          </p>
          <div className="flex items-center gap-4">
            <SortButton
              label="Name"
              field="name"
              active={sortField === "name"}
              order={sortOrder}
              onClick={() => handleSort("name")}
            />
            <SortButton
              label="Category"
              field="category"
              active={sortField === "category"}
              order={sortOrder}
              onClick={() => handleSort("category")}
            />
          </div>
        </div>

        {/* ── Asset List ──────────────────────────────────────────────────── */}
        {totalFiltered === 0 ? (
          <div className="mt-4 rounded-2xl border-2 border-dashed border-border/60 bg-muted/20 p-12 text-center">
            <div className="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-primary/10">
              <FolderOpen className="h-7 w-7 text-primary" />
            </div>
            <h2 className="text-xl font-semibold text-foreground mb-2">
              No assets found
            </h2>
            <p className="text-muted-foreground text-sm max-w-sm mx-auto mb-8">
              {searchTerm
                ? `Nothing matched "${searchTerm}". Try a different search term.`
                : "No assets match the current filters. Try adjusting them."}
            </p>
            <div className="flex flex-col sm:flex-row items-center justify-center gap-3">
              <Button variant="outline" onClick={clearAllFilters}>
                Clear filters
              </Button>
              <a
                href="https://wkf.ms/4mJslYK"
                target="_blank"
                rel="noopener noreferrer"
              >
                <Button
                  variant="outline"
                  className="gap-2 border-primary/30 text-primary hover:bg-primary/5"
                >
                  <ExternalLink className="h-4 w-4" />
                  Request New Asset
                </Button>
              </a>
            </div>
          </div>
        ) : (
          <>
            <div className="space-y-2" role="list" aria-label="Asset library">
              {pagedItems.map((item: any) => (
                <AssetRow
                  key={item.id}
                  item={item}
                  onSelect={() => setSelectedAsset(item)}
                  onDownload={handleDownload}
                />
              ))}
            </div>

            {/* ── Pagination controls ──────────────────────────────────────── */}
            {totalPages > 1 && (
              <div className="flex items-center justify-center gap-2 mt-6">
                <Button
                  variant="outline"
                  size="sm"
                  disabled={safePage === 0}
                  onClick={() => setPage((p) => Math.max(0, p - 1))}
                  className="gap-1.5 h-9"
                >
                  <ChevronLeft className="h-4 w-4" />
                  Previous
                </Button>
                <div className="flex items-center gap-1">
                  {Array.from({ length: totalPages }, (_, i) => i)
                    .filter((i) => {
                      if (totalPages <= 7) return true;
                      if (i === 0 || i === totalPages - 1) return true;
                      if (Math.abs(i - safePage) <= 1) return true;
                      return false;
                    })
                    .reduce<(number | "ellipsis")[]>((acc, i, idx, arr) => {
                      if (idx > 0 && i - (arr[idx - 1] as number) > 1) {
                        acc.push("ellipsis");
                      }
                      acc.push(i);
                      return acc;
                    }, [])
                    .map((item, idx) =>
                      item === "ellipsis" ? (
                        <span
                          key={`ellipsis-${idx}`}
                          className="px-1 text-xs text-muted-foreground"
                        >
                          ...
                        </span>
                      ) : (
                        <button
                          key={item}
                          type="button"
                          onClick={() => setPage(item)}
                          className={`h-9 min-w-[36px] px-2 rounded-lg text-sm font-medium transition-colors ${
                            safePage === item
                              ? "bg-primary text-primary-foreground shadow-sm"
                              : "text-muted-foreground hover:bg-muted hover:text-foreground"
                          }`}
                        >
                          {item + 1}
                        </button>
                      )
                    )}
                </div>
                <Button
                  variant="outline"
                  size="sm"
                  disabled={safePage >= totalPages - 1}
                  onClick={() =>
                    setPage((p) => Math.min(totalPages - 1, p + 1))
                  }
                  className="gap-1.5 h-9"
                >
                  Next
                  <ChevronRight className="h-4 w-4" />
                </Button>
              </div>
            )}
          </>
        )}
      </div>
    </div>
  );
}
