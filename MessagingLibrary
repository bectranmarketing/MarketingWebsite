                    {/* Selection chips */}
                    {quizAnswerCount > 0 && (
                      <div className="flex flex-wrap gap-1.5 mt-3">
                        {quizQuestions.map((qq) => {
                          const v = quizAnswers[qq.id];
                          if (!v) return null;
                          return (
                            <span
                              key={qq.id}
                              className="inline-flex items-center gap-1.5 pl-2.5 pr-1.5 py-1 rounded-full bg-primary/10 border border-primary/20 text-xs"
                            >
                              <span className="text-muted-foreground">{qq.chipLabel}:</span>
                              <span className="font-semibold text-primary">{v}</span>
                              <button
                                type="button"
                                onClick={() => {
                                  setQuizAnswers((prev) => { const n = { ...prev }; delete (n as any)[qq.id]; return n; });
                                  const idx = quizQuestions.findIndex((x) => x.id === qq.id);
                                  if (idx >= 0) setQuizStep(idx);
                                }}
                                className="h-5 w-5 flex items-center justify-center rounded-full hover:bg-primary/20 active:bg-primary/30 text-primary transition-colors"
                                aria-label={`Clear ${qq.chipLabel}`}
                              >
                                <X className="h-3 w-3" />
                              </button>
                            </span>
                          );
                        })}
                      </div>
                    )}
                  </div>

                  {/* Body */}
                  <div className="px-6 py-6">
                    <div className="mb-5">
                      <h3 className="text-2xl font-bold text-foreground">{currentQuizQuestion?.title}</h3>
                      {currentQuizQuestion?.subtitle && (
                        <p className="text-sm text-muted-foreground mt-1">{currentQuizQuestion.subtitle}</p>
                      )}
                      {currentQuizQuestion?.optional && (
                        <span className="inline-block mt-2 text-xs text-muted-foreground border border-border/60 px-2 py-0.5 rounded-full">
                          Optional
                        </span>
                      )}
                    </div>

                    {status === "pending" ? (
                      <div className="space-y-2">
                        {[1, 2, 3].map((i) => (
                          <div key={i} className="h-14 rounded-xl bg-muted animate-pulse" />
                        ))}
                      </div>
                    ) : !Array.isArray(currentQuizOptions) || currentQuizOptions.length === 0 ? (
                      <div className="text-center py-8 text-muted-foreground text-sm">
                        No options — skipping this step…
                      </div>
                    ) : (
                      <div className="grid gap-2">
                        {currentQuizOptions.map((opt) => {
                          const isSelected = quizAnswers[currentQuizQuestion.id] === opt;
                          return (
                            <button
                              key={opt}
                              type="button"
                              onClick={() => quizSelectAnswer(opt)}
                              className={`w-full text-left px-4 py-3.5 rounded-xl border text-sm font-medium transition-all duration-200 outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-1 active:scale-[0.98] min-h-[44px]
                                ${isSelected
                                  ? "border-primary bg-primary/5 text-primary ring-1 ring-primary/30"
                                  : "border-border bg-background text-foreground hover:border-primary/40 hover:bg-muted/40"
                                }`}
                            >
                              <div className="flex items-center justify-between">
                                <span>{opt}</span>
                                {isSelected && (
                                  <span className="flex h-5 w-5 items-center justify-center rounded-full bg-primary text-primary-foreground">
                                    <Check className="h-3 w-3" />
                                  </span>
                                )}
                              </div>
                            </button>
                          );
                        })}
                      </div>
                    )}
                  </div>

                  {/* Footer */}
                  <div className="px-6 py-4 border-t border-border/60 bg-muted/20 flex items-center justify-between gap-3">
                    <div className="flex items-center gap-2">
                      <Button variant="outline" size="sm" onClick={quizBack} disabled={quizStep === 0} className="gap-1.5">
                        <ChevronLeft className="h-4 w-4" />
                        Back
                      </Button>
                      <Button
                        variant="ghost"
                        size="sm"
                        onClick={() => { setQuizAnswers({}); setQuizStep(0); setQuizAutoApplied(false); }}
                        className="text-muted-foreground"
                      >
                        Reset
                      </Button>
                    </div>

                    <div className="flex items-center gap-2">
                      {quizAnswerCount > 0 && (
                        <Button variant="outline" size="sm" onClick={applyQuizNow} className="border-primary/30 text-primary hover:bg-primary/5">
                          Apply filters
                        </Button>
                      )}
                      <Button size="sm" onClick={quizSkip} className="gap-1.5">
                        {quizStep === quizQuestions.length - 1 ? "Finish" : "Skip"}
                        <ChevronRightIcon className="h-4 w-4" />
                      </Button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          )}
        </div>

        {/* ── Global email body styles ──────────────────────────────────────── */}
        <style>{`
          .email-body { font-size: 14px; line-height: 1.65; color: inherit; }
          .email-body p { margin-bottom: 14px; }
          .email-body p:last-child { margin-bottom: 0; }
          .email-body ul { list-style-type: disc; padding-left: 20px; margin: 12px 0; }
          .email-body ol { list-style-type: decimal; padding-left: 20px; margin: 12px 0; }
          .email-body li { margin-bottom: 6px; }
          .email-body strong, .email-body b { font-weight: 600; }
          .email-body a { color: hsl(var(--primary)); text-decoration: none; }
          .email-body a:hover { text-decoration: underline; }
        `}</style>
      </div>
    );
  } catch (err) {
    console.error("[SalesCadenceLibrary] render error:", err);
    return (
      <div className="max-w-5xl mx-auto px-4 py-10">
        <Card className="border-destructive">
          <CardContent className="flex flex-col items-center justify-center py-12 text-center space-y-3">
            <p className="text-lg font-semibold text-destructive">Something went wrong</p>
            <p className="text-sm text-muted-foreground">Please reload the page or contact support.</p>
            <Button onClick={() => window.location.reload()} variant="outline" className="mt-2">
              Reload Page
            </Button>
          </CardContent>
        </Card>
      </div>
    );
  }
}
