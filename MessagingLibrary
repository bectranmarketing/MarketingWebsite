// ─── HTML helpers ───────────────────────────────────────────────────────────────
const sanitizeHtml = (html: string) => {
  // Allow style attributes but strip everything except color so inline
  // highlight colors (e.g. placeholders) survive without opening CSS injection.
  DOMPurify.addHook("afterSanitizeAttributes", (node) => {
    if (node.hasAttribute("style")) {
      const colorMatch = node.getAttribute("style")?.match(/color\s*:\s*[^;]+/i);
      if (colorMatch) {
        node.setAttribute("style", colorMatch[0]);
      } else {
        node.removeAttribute("style");
      }
    }
  });

  const clean = DOMPurify.sanitize(html, {
    ALLOWED_TAGS: ["a", "p", "br", "ul", "ol", "li", "strong", "em", "b", "i", "span", "div", "font"],
    ALLOWED_ATTR: ["href", "target", "rel", "style", "color"],
    ADD_ATTR: ["target"],
  });

  DOMPurify.removeHook("afterSanitizeAttributes");
  return clean;
};

const processHtmlLinks = (html: string) =>
  sanitizeHtml(html || "").replace(/<a /g, '<a target="_blank" rel="noopener noreferrer" ');

// ─── Field helpers ──────────────────────────────────────────────────────────────
const getField = (record: any, ...keys: string[]) => {
  try {
    if (!record || typeof record !== "object") return undefined;
    for (const key of keys) {
      if (record[key] != null) return record[key];
      if (record.fields?.[key] != null) return record.fields[key];
      if (record.data?.[key] != null) return record.data[key];
    }
    const lowerKeys = keys.map((k) => k.toLowerCase());
    const containers = [record, record.fields, record.data].filter(Boolean);
    for (const container of containers) {
      for (const ck of Object.keys(container)) {
        if (lowerKeys.includes(ck.toLowerCase())) {
          const val = (container as any)[ck];
          if (val != null) return val;
        }
      }
    }
    return undefined;
  } catch {
    return undefined;
  }
};

const normalizeValue = (v: any): any => {
  if (v === null || v === undefined || v === "") return "";
  if (Array.isArray(v))
    return v
      .flatMap(normalizeValue)
      .map((x) => (typeof x === "string" ? x.trim() : x))
      .filter((x) => x !== "" && x != null);
  if (typeof v === "object") {
    const extracted = v.label ?? v.name ?? v.value ?? v.title ?? v.id;
    return extracted == null ? "" : String(extracted).trim();
  }
  return String(v).trim();
};

const toArray = (v: any): string[] => {
  const normalized = normalizeValue(v);
  if (Array.isArray(normalized)) return (normalized as any[]).filter(Boolean).map(String);
  if (!normalized) return [];
  const s = String(normalized);
  if (s.includes(",")) return s.split(",").map((x) => x.trim()).filter(Boolean);
  return [s];
};

const buildTags = (record: any) => {
  const tags: { category: string; label: string }[] = [];
  const seen = new Set<string>();
  const add = (category: string, ...fieldKeys: string[]) => {
    const raw = getField(record, ...fieldKeys);
    toArray(raw).forEach((label) => {
      if (!label) return;
      const key = label.toLowerCase();
      if (seen.has(key)) return;
      seen.add(key);
      tags.push({ category, label });
    });
  };
  add("account", "targetAccount", "Target Account", "target_account");
  add("provider", "currentProvider", "Current Provider", "current_provider");
  add("industry", "industry", "Industry");
  add("module", "module", "Module");
  return tags;
};

// ─── Cadence step types ────────────────────────────────────────────────────────
type EmailStep = { type: "email"; emailNumber: number; totalEmails: number; body: string; timing: string; stepIndex: number };
type LinkedInConnectStep = { type: "linkedin-connect"; timing: string; stepIndex: number };
type LinkedInMessageStep = { type: "linkedin-message"; message: string; timing: string; stepIndex: number };
type CadenceStep = EmailStep | LinkedInConnectStep | LinkedInMessageStep;

const EMAIL_TIMINGS = ["Day 1", "Day 5", "Day 9", "Day 13", "Day 17"];

// Builds the full ordered sequence of steps for a cadence record.
// Rule: if "Connect on LinkedIn?" = "yes", insert a LinkedIn Connect step after Email 1.
// Rule: if "LinkedIn Message" has content, insert a LinkedIn Message step the day after Email 2 (Day 6).
const buildCadenceSteps = (cadence: any): CadenceStep[] => {
  if (!cadence) return [];
  const fields = cadence.fields || {};

  const rawLinkedIn = getField(
    cadence,
    "connectOnLinkedIn", "Connect on LinkedIn?", "connect_on_linkedin", "linkedin_connect"
  );
  const rawLinkedInStr = String(rawLinkedIn || "").toLowerCase().trim();
  const shouldConnectLinkedIn =
    rawLinkedInStr !== "" &&
    rawLinkedInStr !== "no" &&
    rawLinkedInStr !== "false" &&
    rawLinkedInStr !== "0";

  const rawLinkedInMsg = getField(
    cadence,
    "linkedInMessage", "LinkedIn Message", "linkedin_message", "linkedinMessage"
  );
  const linkedInMessageText = typeof rawLinkedInMsg === "string" ? rawLinkedInMsg.trim() : "";

  const emailSlots = [fields.email1, fields.email2, fields.email3, fields.email4, fields.email5];
  const totalEmails = emailSlots.filter(Boolean).length;

  const steps: CadenceStep[] = [];
  let stepIndex = 0;
  let emailNumber = 0;

  emailSlots.forEach((body, slotIndex) => {
    if (!body) return;
    emailNumber++;

    steps.push({ type: "email", emailNumber, totalEmails, body, timing: EMAIL_TIMINGS[slotIndex], stepIndex: stepIndex++ });

    // After the first email slot: LinkedIn Connect
    if (slotIndex === 0 && shouldConnectLinkedIn) {
      steps.push({ type: "linkedin-connect", timing: "Day 2", stepIndex: stepIndex++ });
    }

    // After the second email slot: LinkedIn Message (day after Email 2)
    if (slotIndex === 1 && linkedInMessageText) {
      steps.push({ type: "linkedin-message", message: linkedInMessageText, timing: "Day 6", stepIndex: stepIndex++ });
    }
  });

  return steps;
};

