// ─── Main Component ────────────────────────────────────────────────────────────
export default function Block() {
  // Filter state
  const [searchQuery, setSearchQuery] = useState("");
  const [selectedPosition, setSelectedPosition] = useState("");
  const [selectedProvider, setSelectedProvider] = useState("");
  const [selectedTargetAccount, setSelectedTargetAccount] = useState("");
  const [selectedIndustry, setSelectedIndustry] = useState("");
  const [selectedModule, setSelectedModule] = useState("");
  const [selectedCadence, setSelectedCadence] = useState<any>(null);
  const [copiedId, setCopiedId] = useState<number | null>(null);
  const [expandedEmails, setExpandedEmails] = useState<Record<number, boolean>>({});
  const [viewAll, setViewAll] = useState(false);
  const [filtersOpen, setFiltersOpen] = useState(false);

  // Quiz state
  const [quizOpen, setQuizOpen] = useState(false);
  const [quizStep, setQuizStep] = useState(0);
  const [quizAnswers, setQuizAnswers] = useState<Partial<Record<QuizId, string>>>({});
  const [quizAutoApplied, setQuizAutoApplied] = useState(false);

  const searchRef = useRef<HTMLInputElement>(null);
  const quizContainerRef = useRef<HTMLDivElement>(null);

  const anyFieldFilled = selectedPosition || selectedProvider || selectedTargetAccount || selectedIndustry || selectedModule;
  const activeFilterCount = [selectedPosition, selectedProvider, selectedTargetAccount, selectedIndustry, selectedModule].filter(Boolean).length;
  const hasSearchOrFilter = searchQuery || anyFieldFilled || viewAll;

  // ─── Active filter chips (for strip below filters) ─────────────────────────
  const activeFilters: { label: string; value: string; clear: () => void }[] = [
    ...(selectedPosition ? [{ label: "Recipient", value: selectedPosition, clear: () => { setSelectedPosition(""); handleFilterChange(); } }] : []),
    ...(selectedProvider ? [{ label: "Provider", value: selectedProvider, clear: () => { setSelectedProvider(""); handleFilterChange(); } }] : []),
    ...(selectedTargetAccount ? [{ label: "Account", value: selectedTargetAccount, clear: () => { setSelectedTargetAccount(""); handleFilterChange(); } }] : []),
    ...(selectedIndustry ? [{ label: "Industry", value: selectedIndustry, clear: () => { setSelectedIndustry(""); handleFilterChange(); } }] : []),
    ...(selectedModule ? [{ label: "Module", value: selectedModule, clear: () => { setSelectedModule(""); handleFilterChange(); } }] : []),
  ];

  // ─── Data fetching ─────────────────────────────────────────────────────────
  const filter = useMemo(() => {
    const filters: any[] = [q.array("status").hasAllOf(["1"])];
    if (selectedPosition) filters.push(q.array("position").isOneOf([selectedPosition]));
    if (selectedProvider) filters.push(q.text("currentProvider").is(selectedProvider));
    if (selectedTargetAccount) filters.push(q.text("targetAccount").is(selectedTargetAccount));
    if (selectedIndustry) filters.push(q.array("industry").hasAllOf([selectedIndustry]));
    if (selectedModule) filters.push(q.array("module").hasAllOf([selectedModule]));
    return filters.length > 1 ? q.and(...filters) : filters[0];
  }, [selectedPosition, selectedProvider, selectedTargetAccount, selectedIndustry, selectedModule]);

  const { data, status } = useRecords({
    select,
    where: filter,
    orderBy: q.asc("name"),
    count: 100,
  });

  const safeRawResults = useMemo(() => {
    try {
      if (!data?.pages) return [];
      const items = data.pages.flatMap((page: any) => page?.items || []);
      return Array.isArray(items) ? items.filter(Boolean) : [];
    } catch {
      return [];
    }
  }, [data]);

  const viewModels = useMemo(
    () =>
      safeRawResults.map((record: any, index: number) => {
        const fields = record?.fields || {};
        const emailCount = [fields.email1, fields.email2, fields.email3, fields.email4, fields.email5].filter(Boolean).length;
        const rawLinkedIn = getField(record, "connectOnLinkedIn", "Connect on LinkedIn?", "connect_on_linkedin");
        const rawLinkedInStr = String(rawLinkedIn || "").toLowerCase().trim();
        const hasLinkedIn = rawLinkedInStr !== "" && rawLinkedInStr !== "no" && rawLinkedInStr !== "false" && rawLinkedInStr !== "0";
        const rawLinkedInMsg = getField(record, "linkedInMessage", "LinkedIn Message", "linkedin_message");
        const hasLinkedInMsg = !!(typeof rawLinkedInMsg === "string" ? rawLinkedInMsg.trim() : rawLinkedInMsg);
        const stepCount = emailCount + (hasLinkedIn ? 1 : 0) + (hasLinkedInMsg ? 1 : 0);
        return {
          id: record?.id || record?._id || record?.itemId || `item-${index}`,
          title: fields.name || "",
          description: fields.scenario || "",
          tags: buildTags(record),
          emailCount,
          stepCount,
          hasLinkedIn,
          hasLinkedInMsg,
          rawRecord: record,
        };
      }),
    [safeRawResults]
  );

  const matchingViewModels = useMemo(() => {
    if (!Array.isArray(viewModels)) return [];
    if (!searchQuery) return viewModels;
    const s = searchQuery.toLowerCase();
    return viewModels
      .filter((vm) => vm.title.toLowerCase().includes(s) || vm.description.toLowerCase().includes(s))
      .sort((a, b) => a.title.toLowerCase().localeCompare(b.title.toLowerCase()));
  }, [viewModels, searchQuery]);

  // ─── Cadence steps for detail view ────────────────────────────────────────
  const cadenceSteps = useMemo(() => buildCadenceSteps(selectedCadence), [selectedCadence]);

  // ─── Handlers ──────────────────────────────────────────────────────────────
  const toggleEmail = (index: number) =>
    setExpandedEmails((prev) => ({ ...prev, [index]: !prev[index] }));

  const copyToClipboard = async (email: any, index: number, e: React.MouseEvent) => {
    e.stopPropagation();
    try {
      const processedHtml = processHtmlLinks(email.body);
      const tempDiv = document.createElement("div");
      tempDiv.innerHTML = processedHtml;
      const plainText = tempDiv.innerText || tempDiv.textContent || "";

      if (navigator.clipboard && (navigator.clipboard as any).write) {
        const blobHtml = new Blob([processedHtml], { type: "text/html" });
        const blobText = new Blob([plainText], { type: "text/plain" });
        const item = new (window as any).ClipboardItem({ "text/html": blobHtml, "text/plain": blobText });
        await (navigator.clipboard as any).write([item]);
      } else {
        const el = document.createElement("div");
        el.contentEditable = "true";
        el.innerHTML = processedHtml;
        el.style.cssText = "position:fixed;left:-9999px";
        document.body.appendChild(el);
        const range = document.createRange();
        range.selectNodeContents(el);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
        document.execCommand("copy");
        document.body.removeChild(el);
      }

      setCopiedId(index);
      toast.success("Email copied with formatting!");
      setTimeout(() => setCopiedId(null), 2000);
    } catch (err) {
      toast.error("Failed to copy email");
    }
  };

  const handleFilterChange = () => {
    setSelectedCadence(null);
    setExpandedEmails({});
  };

  const clearAllFilters = () => {
    setSearchQuery("");
    setSelectedPosition("");
    setSelectedProvider("");
    setSelectedTargetAccount("");
    setSelectedIndustry("");
    setSelectedModule("");
    setSelectedCadence(null);
    setExpandedEmails({});
    setViewAll(false);
    setFiltersOpen(false);
  };

  // ─── Live dropdown options ─────────────────────────────────────────────────
  const computeLiveOptions = (fieldKeys: string[]) => {
    const unique = new Map<string, string>();
    safeRawResults.forEach((rec) => {
      toArray(getField(rec, ...fieldKeys)).forEach((val) => {
        const label = String(val || "").trim();
        if (!label) return;
        const lower = label.toLowerCase();
        if (!unique.has(lower)) unique.set(lower, label);
      });
    });
    const all = Array.from(unique.values()).sort((a, b) => a.localeCompare(b));
    const special = all.filter((x) => ["unknown", "general"].includes(x.toLowerCase()));
    const normal = all.filter((x) => !["unknown", "general"].includes(x.toLowerCase()));
    return [...normal, ...special];
  };

  const livePositionOptions = useMemo(() => computeLiveOptions(quizQuestions[0].fieldKeys), [safeRawResults]);
  const liveProviderOptions = useMemo(() => computeLiveOptions(quizQuestions[1].fieldKeys), [safeRawResults]);
  const liveAccountOptions = useMemo(() => computeLiveOptions(quizQuestions[2].fieldKeys), [safeRawResults]);
  const liveIndustryOptions = useMemo(() => computeLiveOptions(quizQuestions[3].fieldKeys), [safeRawResults]);
  const liveModuleOptions = useMemo(() => computeLiveOptions(quizQuestions[4].fieldKeys), [safeRawResults]);

  // ─── Quiz logic ─────────────────────────────────────────────────────────────
  const computeQuizFilteredRecords = (excludeId: QuizId | null = null) => {
    let filtered = [...safeRawResults];
    quizQuestions.forEach((qq) => {
      if (excludeId && qq.id === excludeId) return;
      const selectedVal = quizAnswers[qq.id];
      if (!selectedVal) return;
      filtered = filtered.filter((rec) => {
        const raw = getField(rec, ...qq.fieldKeys);
        return toArray(raw).some((x) => x.toLowerCase() === selectedVal.toLowerCase());
      });
    });
    return filtered;
  };

  const quizFilteredRecords = useMemo(
    () => computeQuizFilteredRecords(null),
    [safeRawResults, quizAnswers]
  );

  const computeQuizOptionsForStep = (stepIndex: number) => {
    const question = quizQuestions[stepIndex];
    const base = computeQuizFilteredRecords(question.id);
    const unique = new Map<string, string>();
    base.forEach((rec) => {
      toArray(getField(rec, ...question.fieldKeys)).forEach((val) => {
        const label = String(val || "").trim();
        if (!label) return;
        const lower = label.toLowerCase();
        if (!unique.has(lower)) unique.set(lower, label);
      });
    });
    const all = Array.from(unique.values()).sort((a, b) => a.localeCompare(b));
    const special = all.filter((x) => ["unknown", "general"].includes(x.toLowerCase()));
    const normal = all.filter((x) => !["unknown", "general"].includes(x.toLowerCase()));
    return [...normal, ...special];
  };

  const currentQuizQuestion = quizQuestions[quizStep];
  const currentQuizOptions = useMemo(() => {
    if (!quizOpen || status !== "success" || !currentQuizQuestion) return [];
    return computeQuizOptionsForStep(quizStep);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [quizOpen, status, quizStep, safeRawResults, quizAnswers]);

  useEffect(() => {
    if (!quizOpen || status !== "success" || !currentQuizQuestion) return;
    const opts = currentQuizOptions;

    if (opts.length === 0) {
      if (quizStep < quizQuestions.length - 1) setQuizStep((s) => s + 1);
      return;
    }
    const already = quizAnswers[currentQuizQuestion.id];
    if (!already && opts.length === 1) {
      setQuizAnswers((prev) => ({ ...prev, [currentQuizQuestion.id]: opts[0] }));
      return;
    }
    if (quizFilteredRecords.length === 1 && !quizAutoApplied) {
      applyQuizNow();
      setQuizAutoApplied(true);
      setQuizOpen(false);
      return;
    }
    if (already && quizStep < quizQuestions.length - 1) {
      setQuizStep((s) => s + 1);
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [quizOpen, status, quizStep, currentQuizOptions, quizAnswers, quizFilteredRecords]);

  const openQuiz = () => {
    setQuizAnswers({});
    setQuizStep(0);
    setQuizAutoApplied(false);
    setQuizOpen(true);
    setTimeout(() => quizContainerRef.current?.focus(), 0);
  };

  const closeQuiz = () => setQuizOpen(false);

  const quizSelectAnswer = (value: string) => {
    if (!currentQuizQuestion) return;
    setQuizAnswers((prev) => ({ ...prev, [currentQuizQuestion.id]: value }));
  };

  const applyQuizNow = () => {
    setSelectedPosition(quizAnswers.position || "");
    setSelectedProvider(quizAnswers.provider || "");
    setSelectedTargetAccount(quizAnswers.targetAccount || "");
    setSelectedIndustry(quizAnswers.industry || "");
    setSelectedModule(quizAnswers.module || "");
    setQuizOpen(false);
    setSelectedCadence(null);
    setExpandedEmails({});
    setViewAll(true);
  };

  const quizSkip = () => {
    if (!currentQuizQuestion) return;
    setQuizAnswers((prev) => { const n = { ...prev }; delete (n as any)[currentQuizQuestion.id]; return n; });
    if (quizStep < quizQuestions.length - 1) setQuizStep((s) => s + 1);
    else applyQuizNow();
  };

  const quizBack = () => { if (quizStep > 0) setQuizStep((s) => s - 1); };

  const quizAnswerCount = Object.values(quizAnswers).filter(Boolean).length;

  useEffect(() => {
    if (!quizOpen) return;
    const onKey = (e: KeyboardEvent) => { if (e.key === "Escape") closeQuiz(); };
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, [quizOpen]);

  // ─── Render ────────────────────────────────────────────────────────────────
  try {
    return (
      <div className="min-h-screen bg-background">
        <div className="max-w-5xl mx-auto px-4 py-10">

          {/* ── Page Header ─────────────────────────────────────────────────── */}
          <div className="mb-8">
            <h1 className="text-3xl font-bold tracking-tight text-foreground">Sales Cadence Library</h1>
            <p className="mt-1.5 text-muted-foreground text-base">
              Find the perfect multi-touch outreach sequence for any prospect — search, filter, or take the quiz.
            </p>
          </div>

          {/* ── Search + Quiz CTA ────────────────────────────────────────────── */}
          <div className="flex gap-3 mb-4">
            <div className="relative flex-1">
              <Search className="absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground pointer-events-none" />
              <Input
                ref={searchRef}
                type="text"
                placeholder="Search by name or scenario…"
